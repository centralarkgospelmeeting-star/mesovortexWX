{
  "name": "mesovortexwx",
  "version": "1.0.0",
  "private": true,
  "description": "MesoVortexWX weather radar desktop application",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "prepare:desktop": "node scripts/prepare-desktop.mjs",
    "dist:windows": "next build && npm run prepare:desktop && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "next": "14.2.15",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "leaflet": "^1.9.4",
    "react-leaflet": "^4.2.1",
    "maplibre-gl": "6.16.0",
    "axios": "^1.7.2",
    "chart.js": "^4.4.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "20.16.9",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.1",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.14",
    "typescript": "5.6.3",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "org.mesovortexwx.desktop",
    "productName": "MesoVortexWX",
    "asar": false,
    "directories": { "output": "dist" },
    "files": ["desktop/**/*", "package.json", ".next/standalone/**/*"],
    "win": {
      "icon": "icon.ico",
      "target": ["nsis"],
      "artifactName": "MesoVortexWX-Setup.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MesoVortexWX"
    }
  }
}
