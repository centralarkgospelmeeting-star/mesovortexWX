+    { value: '50 dBZ (severe core)', color: '#fd9500' },
+    { value: '55 dBZ (large hail)', color: '#fd0000' },
+    { value: '60 dBZ (destructive)', color: '#d40000' },
+    { value: '65 dBZ (giant hail)', color: '#f800fd' },
+    { value: '70 dBZ (violent)', color: '#9854c6' },
+    { value: '75+ dBZ (extreme)', color: '#ffffff' },
