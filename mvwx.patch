@@ -0,0 +1,79 @@
+import { NextResponse } from 'next/server';
+import { fetchJsonWithTimeout, errorPayload } from '@/lib/api-utils';
+
+export const dynamic = 'force-dynamic';
+
+// SPC convective outlook GeoJSON layers. Only combinations that SPC actually
+// publishes are listed here — Day 1 carries all hazards, Day 2 carries
+// categorical + tornado/wind/hail, Day 3 carries categorical + probability.
+const SPC_PATHS: Record<string, Record<string, string>> = {
+  cat: {
+    'Day 1': 'day1otlk_cat.lyr.geojson',
+    'Day 2': 'day2otlk_cat.lyr.geojson',
+    'Day 3': 'day3otlk_cat.lyr.geojson',
+  },
+  torn: {
+    'Day 1': 'day1otlk_torn.lyr.geojson',
+    'Day 2': 'day2otlk_torn.lyr.geojson',
+  },
+  wind: {
+    'Day 1': 'day1otlk_wind.lyr.geojson',
+    'Day 2': 'day2otlk_wind.lyr.geojson',
+  },
+  hail: {
+    'Day 1': 'day1otlk_hail.lyr.geojson',
+    'Day 2': 'day2otlk_hail.lyr.geojson',
+  },
+};
+
+const BASE = 'https://www.spc.noaa.gov/products/outlook';
+
+export async function GET(request: Request) {
+  const { searchParams } = new URL(request.url);
+  const product = (searchParams.get('product') || 'cat').toLowerCase();
+  const day = searchParams.get('day') || 'Day 1';
+
+  const file = SPC_PATHS[product]?.[day];
+  if (!file) {
+    return NextResponse.json(
+      {
+        type: 'FeatureCollection',
+        features: [],
+        _meta: {
+          ok: false,
+          source: BASE,
+          error: `No SPC layer published for ${product} ${day}`,
+          fetchedAt: new Date().toISOString(),
+        },
+      },
+      { headers: { 'Cache-Control': 'no-store' } }
+    );
+  }
+
+  const source = `${BASE}/${file}`;
+  const result = await fetchJsonWithTimeout(source, {
+    headers: { 'User-Agent': 'MesoVortexWX/2.0 (contact@mesovortexwx.internal)' },
+    timeoutMs: 12000,
+  });
+
+  if (!result.ok) {
+    return NextResponse.json(errorPayload({ type: 'FeatureCollection', features: [] }, source, result.error), {
+      headers: { 'Cache-Control': 'no-store' },
+    });
+  }
+
+  return NextResponse.json(
+    {
+      ...result.data,
+      _meta: {
+        fetchedAt: new Date().toISOString(),
+        source,
+        ok: true,
+        product,
+        day,
+        attribution: 'NOAA Storm Prediction Center',
+      },
+    },
+    { headers: { 'Cache-Control': 'public, max-age=300, stale-while-revalidate=900' } }
+  );
+}
