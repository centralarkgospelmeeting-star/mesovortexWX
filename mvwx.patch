+'use client';
+
+import { useState } from 'react';
+import { getProductsByCategory, resolveTileUrl, AVAILABILITY_LABEL, type ProductDef } from '../../../lib/product-config';
+import type { OverlayState } from '../../../lib/shell/types';
+import { Checkbox, EmptyNote, Field, PanelSection, Select, Slider, Toggle } from '../ui';
+import { RADAR_SITES } from '../../../lib/radar-config';
+
+export type ControlProps = {
+  product: ProductDef;
+  onSelectProduct: (id: string) => void;
+  radarSite: string;
+  onSelectSite: (id: string) => void;
+  tilt: string;
+  onSelectTilt: (t: string) => void;
+  opacity: number;
+  onChangeOpacity: (v: number) => void;
+  smoothing: boolean;
+  onToggleSmoothing: (v: boolean) => void;
+  overlays: OverlayState;
+  onToggleOverlay: (key: keyof OverlayState, value: boolean) => void;
+};
+
+const TILTS = ['0.5', '0.9', '1.3', '1.8', '2.4', '3.1'];
+
+const NEXRAD_SITES = RADAR_SITES.filter((s) => s.network === 'NEXRAD').sort((a, b) =>
+  a.id.localeCompare(b.id)
+);
+
+export function RadarControls({
+  product,
+  onSelectProduct,
+  radarSite,
+  onSelectSite,
+  tilt,
+  onSelectTilt,
+  opacity,
+  onChangeOpacity,
+  smoothing,
+  onToggleSmoothing,
+  overlays,
+  onToggleOverlay,
+}: ControlProps) {
+  const [advancedOpen, setAdvancedOpen] = useState(false);
+  const products = getProductsByCategory('radar');
+
+  return (
+    <>
+      <PanelSection title="Radar Product">
+        <Field label="Moment" hint={AVAILABILITY_LABEL[product.availability]}>
+          <Select value={product.id} onChange={(e) => onSelectProduct(e.target.value)}>
+            {products.map((p) => (
+              <option key={p.id} value={p.id}>
+                {p.label}
+                {p.availability !== 'live' ? ` — ${AVAILABILITY_LABEL[p.availability]}` : ''}
+              </option>
+            ))}
+          </Select>
+        </Field>
+        <p className="text-[10px] leading-snug text-slate-500">{product.description}</p>
+      </PanelSection>
+
+      <PanelSection title="Radar Site">
+        <Select value={radarSite} onChange={(e) => onSelectSite(e.target.value)}>
+          {NEXRAD_SITES.map((s) => (
+            <option key={s.id} value={s.id}>
+              {s.id} — {s.name}
+            </option>
+          ))}
+        </Select>
+        <Field label="Elevation Tilt" hint={`${tilt}°`}>
+          <div className="grid grid-cols-3 gap-1">
+            {TILTS.map((t) => (
+              <button
+                key={t}
+                onClick={() => onSelectTilt(t)}
+                className={`rounded-lg py-1 font-mono text-[11px] font-bold transition ${
+                  tilt === t ? 'bg-cyan-500 text-slate-950' : 'bg-slate-900 text-slate-400 hover:text-white'
+                }`}
+              >
+                {t}°
+              </button>
+            ))}
+          </div>
+        </Field>
+        {product.sourceKind === 'mrms' && (
+          <p className="text-[10px] leading-snug text-slate-500">
+            This product is a national mosaic and is not tilt-specific.
+          </p>
+        )}
+      </PanelSection>
+
+      <PanelSection title="Display">
+        <Field label="Opacity" hint={`${Math.round(opacity * 100)}%`}>
+          <Slider value={opacity} min={0.2} max={1} step={0.05} onChange={onChangeOpacity} ariaLabel="Radar opacity" />
+        </Field>
+        <Toggle label="Smoothing" checked={smoothing} onChange={onToggleSmoothing} description="Interpolate raster tiles" />
+      </PanelSection>
+
+      <PanelSection title="Map Overlays">
+        <Checkbox label="Lightning" icon="⚡" checked={overlays.lightning} onChange={(v) => onToggleOverlay('lightning', v)} />
+        <Checkbox label="Storm Reports (LSR)" icon="🌪️" checked={overlays.stormReports} onChange={(v) => onToggleOverlay('stormReports', v)} />
+        <Checkbox label="Radar Sites" icon="📡" checked={overlays.radarSites} onChange={(v) => onToggleOverlay('radarSites', v)} />
+        <Checkbox label="Range Rings" icon="◎" checked={overlays.rangeRings} onChange={(v) => onToggleOverlay('rangeRings', v)} />
+        <Checkbox label="County Boundaries" icon="▦" checked={overlays.counties} onChange={(v) => onToggleOverlay('counties', v)} />
+        <Checkbox label="State Boundaries" icon="▤" checked={overlays.states} onChange={(v) => onToggleOverlay('states', v)} />
+        <Checkbox label="Warnings & Watches" icon="⚠️" checked={overlays.warnings} onChange={(v) => onToggleOverlay('warnings', v)} />
+        <Checkbox label="METAR Stations" icon="🌡️" checked={overlays.metars} onChange={(v) => onToggleOverlay('metars', v)} />
+      </PanelSection>
+
+      <PanelSection
+        title="Advanced Radar"
+        action={
+          <button
+            onClick={() => setAdvancedOpen((v) => !v)}
+            className="text-[10px] font-bold text-cyan-400 hover:text-cyan-300"
+          >
+            {advancedOpen ? 'Hide' : 'Show'}
+          </button>
+        }
+      >
+        {advancedOpen ? (
+          <div className="space-y-1.5">
+            <EmptyNote>
+              Cross sections, beam visualisation, 3D volume analysis and radar comparison are planned. They are
+              not yet implemented and are shown here as planned capability only.
+            </EmptyNote>
+          </div>
+        ) : (
+          <p className="text-[10px] text-slate-500">
+            Cross sections · beam visualisation · 3D analysis · radar comparison
+          </p>
+        )}
+      </PanelSection>
+    </>
+  );
+}
