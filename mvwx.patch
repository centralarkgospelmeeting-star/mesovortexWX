@@ -0,0 +1,126 @@
+'use client';
+
+import type { PlaybackFrame } from '../../lib/shell/usePlayback';
+
+type Props = {
+  frames: PlaybackFrame[];
+  index: number;
+  playing: boolean;
+  isLive: boolean;
+  speedMs: number;
+  loopAvailable: boolean;
+  timestampLabel: string;
+  onTogglePlay: () => void;
+  onStep: (dir: -1 | 1) => void;
+  onScrub: (index: number) => void;
+  onGoLive: () => void;
+  onSpeedChange: (ms: number) => void;
+};
+
+const SPEEDS = [
+  { label: '0.5×', ms: 900 },
+  { label: '1×', ms: 450 },
+  { label: '2×', ms: 220 },
+  { label: '4×', ms: 110 },
+];
+
+export function PlaybackControls({
+  frames,
+  index,
+  playing,
+  isLive,
+  speedMs,
+  loopAvailable,
+  timestampLabel,
+  onTogglePlay,
+  onStep,
+  onScrub,
+  onGoLive,
+  onSpeedChange,
+}: Props) {
+  const max = Math.max(0, frames.length - 1);
+
+  return (
+    <div className="space-y-2 rounded-xl border border-slate-800/80 bg-slate-900/60 p-2.5">
+      <div className="flex items-center justify-between text-[10px] font-bold uppercase text-slate-400">
+        <span>Playback</span>
+        <span className={`font-mono ${isLive ? 'text-emerald-400' : 'text-cyan-300'}`}>
+          {isLive ? 'LIVE' : timestampLabel}
+        </span>
+      </div>
+
+      <div className="flex items-center gap-1.5">
+        <button
+          onClick={() => onStep(-1)}
+          aria-label="Previous frame"
+          className="flex h-7 w-7 items-center justify-center rounded-lg bg-slate-800 font-bold text-slate-200 hover:bg-slate-700"
+        >
+          ◀
+        </button>
+        <button
+          onClick={onTogglePlay}
+          disabled={!loopAvailable}
+          aria-label={playing ? 'Pause' : 'Play'}
+          className="flex h-7 flex-1 items-center justify-center rounded-lg bg-blue-600 font-bold text-white shadow-md transition hover:bg-blue-500 disabled:opacity-40"
+        >
+          {playing ? '❚❚ PAUSE' : '▶ PLAY'}
+        </button>
+        <button
+          onClick={() => onStep(1)}
+          aria-label="Next frame"
+          className="flex h-7 w-7 items-center justify-center rounded-lg bg-slate-800 font-bold text-slate-200 hover:bg-slate-700"
+        >
+          ▶
+        </button>
+        <button
+          onClick={onGoLive}
+          className={`rounded-lg border px-2 py-1 text-[10px] font-black uppercase transition ${
+            isLive
+              ? 'border-emerald-500/60 bg-emerald-500/20 text-emerald-300'
+              : 'border-emerald-500/40 bg-emerald-500/10 text-emerald-400 hover:bg-emerald-500/20'
+          }`}
+        >
+          LIVE
+        </button>
+      </div>
+
+      {/* Scrubber */}
+      <input
+        type="range"
+        aria-label="Playback timeline"
+        min={0}
+        max={max}
+        step={1}
+        value={index}
+        onChange={(e) => onScrub(parseInt(e.target.value, 10))}
+        className="h-1.5 w-full cursor-pointer accent-cyan-400"
+      />
+
+      <div className="flex items-center justify-between text-[10px] text-slate-400">
+        <span className="font-mono">
+          {index + 1}/{frames.length} frames
+        </span>
+        <div className="flex items-center gap-1">
+          <span>Speed</span>
+          {SPEEDS.map((s) => (
+            <button
+              key={s.label}
+              onClick={() => onSpeedChange(s.ms)}
+              className={`rounded px-1.5 py-0.5 font-bold transition ${
+                speedMs === s.ms ? 'bg-cyan-500 text-slate-950' : 'bg-slate-800 text-slate-400 hover:text-white'
+              }`}
+            >
+              {s.label}
+            </button>
+          ))}
+        </div>
+      </div>
+
+      {!loopAvailable && (
+        <p className="rounded border border-amber-500/30 bg-amber-500/5 px-2 py-1 text-[10px] leading-snug text-amber-300">
+          Historical stepping is not authoritative for this product. Only the live frame is shown.
+        </p>
+      )}
+    </div>
+  );
+}
