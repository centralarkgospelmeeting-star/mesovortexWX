 import { NextRequest, NextResponse } from 'next/server';
 
+// User-submitted spotter reports are held in memory for the life of the server
+// process. They are clearly flagged as unverified community input and are never
+// presented as official warnings.
+type StoredReport = {
+  id: string;
+  hazardType: string;
+  description: string;
+  hailSize?: string;
+  lat: number;
+  lon: number;
+  timestamp: string;
+  callsign: string;
+  submittedAt: number;
+};
+
+const submittedReports: StoredReport[] = [];
+const MAX_STORED = 500;
+const MAX_AGE_MS = 6 * 60 * 60 * 1000;
+
+function pruneReports() {
+  const cutoff = Date.now() - MAX_AGE_MS;
+  for (let i = submittedReports.length - 1; i >= 0; i -= 1) {
+    if (submittedReports[i].submittedAt < cutoff) submittedReports.splice(i, 1);
+  }
+  if (submittedReports.length > MAX_STORED) {
+    submittedReports.splice(0, submittedReports.length - MAX_STORED);
+  }
+}
+
+function submittedToFeature(r: StoredReport) {
+  return {
+    type: 'Feature' as const,
+    geometry: { type: 'Point' as const, coordinates: [r.lon, r.lat] },
+    properties: {
+      id: r.id,
+      name: r.callsign,
+      hazardType: r.hazardType,
+      report: r.description || r.hazardType,
+      hailSize: r.hailSize,
+      time: r.timestamp,
+      verified: false,
+      source: 'user-submitted',
+    },
+  };
+}
+
+export async function POST(req: NextRequest) {
+  let body: any;
+  try {
+    body = await req.json();
+  } catch {
+    return NextResponse.json({ ok: false, error: 'Request must contain valid JSON.' }, { status: 400 });
+  }
+
+  const lat = Number(body?.lat);
+  const lon = Number(body?.lon);
+  if (!Number.isFinite(lat) || !Number.isFinite(lon)) {
+    return NextResponse.json({ ok: false, error: 'Report requires numeric lat and lon.' }, { status: 400 });
+  }
+  if (lat < -90 || lat > 90 || lon < -180 || lon > 180) {
+    return NextResponse.json({ ok: false, error: 'Coordinates are out of range.' }, { status: 400 });
+  }
+
+  const report: StoredReport = {
+    id: String(body?.id || `spotter-${Date.now()}`),
+    hazardType: String(body?.hazardType || 'Unknown').slice(0, 60),
+    description: String(body?.description || '').slice(0, 600),
+    hailSize: body?.hailSize ? String(body.hailSize).slice(0, 40) : undefined,
+    lat,
+    lon,
+    timestamp: String(body?.timestamp || new Date().toISOString()),
+    callsign: String(body?.callsign || 'Anonymous').slice(0, 60),
+    submittedAt: Date.now(),
+  };
+
+  submittedReports.push(report);
+  pruneReports();
+
+  return NextResponse.json({ ok: true, report: submittedToFeature(report) }, { status: 201 });
+}
