+};
+
+const SAT_IR_LEGEND: LegendSpec = {
+  kind: 'gradient',
+  title: 'Brightness Temperature',
+  unit: '°C',
+  stops: [
+    { value: '0 °C (low cloud / land)', color: '#94a3b8' },
+    { value: '-30 °C (mid cloud)', color: '#f59e0b' },
+    { value: '-50 °C (deep convection)', color: '#dc2626' },
+    { value: '-65 °C (intense updraft)', color: '#7c3aed' },
+    { value: '-80 °C (overshooting top)', color: '#0f172a' },
+  ],
+};
+
+const SAT_VIS_LEGEND: LegendSpec = {
+  kind: 'gradient',
+  title: 'Visible Reflectance',
+  unit: '',
