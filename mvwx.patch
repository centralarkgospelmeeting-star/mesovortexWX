+
+export type OutlookProvider = 'SPC' | 'WPC' | 'NHC' | 'CPC';
+export type OutlookDay = 'Day 1' | 'Day 2' | 'Day 3';
+
+export type ShellPrefs = {
+  schemaVersion: 3;
+  category: NavCategory;
+  radarProductId: string;
+  compositeProductId: string;
+  satelliteProductId: string;
+  modelProductId: string;
+  outlookProductId: string;
+  radarSite: string;
+  tilt: string;
+  basemap: BasemapType;
+  opacity: number;
