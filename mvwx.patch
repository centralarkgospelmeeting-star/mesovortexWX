+  ],
+};
+
+const AZSHEAR_LEGEND: LegendSpec = {
+  kind: 'gradient',
+  title: 'Azimuthal Shear',
+  unit: '×10⁻³ s⁻¹',
+  stops: [
+    { value: 'low (background)', color: '#1e293b' },
+    { value: 'moderate (organized)', color: '#10b981' },
+    { value: 'strong (rotation)', color: '#fdf802' },
+    { value: 'extreme (mesocyclone)', color: '#fd0000' },
+  ],
+};
+
+const PRECIP_LEGEND: LegendSpec = {
+  kind: 'gradient',
+  title: 'Precipitation Rate',
+  unit: 'in/hr',
+  stops: [
+    { value: '0.05 (light)', color: '#a7f3d0' },
+    { value: '0.25 (moderate)', color: '#34d399' },
+    { value: '0.75 (heavy)', color: '#fdf802' },
+    { value: '1.50 (very heavy)', color: '#fd9500' },
+    { value: '3.00+ (torrential)', color: '#fd0000' },
