+'use client';
+
+import { useCallback, useEffect, useMemo, useRef, useState } from 'react';
+import { RadarMap } from '../RadarMap';
+import { UniversalDataLegend } from './UniversalDataLegend';
+import { TopNavigation, type GeoResult } from './TopNavigation';
+import { FloatingProductPanel } from './FloatingProductPanel';
+import { WarningDrawer } from './WarningDrawer';
+import { WarningMapDetails } from './WarningMapDetails';
+import { MainMenuDrawer } from './MainMenuDrawer';
+import { SettingsWorkspace } from './SettingsWorkspace';
+import { WeatherAssistant } from '../WeatherAssistant';
+import { METARPanel } from '../METARPanel';
+import { SpotterReportModal, type SpotterReport } from '../SpotterReportModal';
+import { HyperlocalDashboardModal } from '../HyperlocalDashboardModal';
+import { RadarControls, type ControlProps } from './controls/RadarControls';
+import { CompositeControls } from './controls/CompositeControls';
+import { SatelliteControls } from './controls/SatelliteControls';
+import { ModelControls } from './controls/ModelControls';
+import { OutlookControls } from './controls/OutlookControls';
+
+import {
+  AVAILABILITY_LABEL,
+  getProduct,
+  resolveTileUrl,
+  type ProductCategory,
+} from '../../lib/product-config';
+import {
+  DEFAULT_PREFS,
+  NAV_TO_PRODUCT_CATEGORY,
+  productIdFieldFor,
+  type NavCategory,
+  type MapFocus,
+  type OutlookDay,
+  type ShellPrefs,
+} from '../../lib/shell/types';
+import { loadPrefs, savePrefs, clearPrefs } from '../../lib/shell/persistence';
+import { usePlayback } from '../../lib/shell/usePlayback';
+import { useWarnings, warningCentroid, type WarningAlert } from '../../lib/shell/useWarnings';
+import { useLightning } from '../../lib/useLightning';
+import { RADAR_SITES } from '../../lib/radar-config';
+
+const FRAME_COUNT = 12;
+
+const OUTLOOK_COLORS: Record<string, { match: string; color: string }[]> = {
+  spc_cat: [
+    { match: 'TSTM', color: '#c1e9c1' },
+    { match: 'MRGL', color: '#7fc57f' },
+    { match: 'SLGT', color: '#f6f67d' },
+    { match: 'ENH', color: '#edbf69' },
+    { match: 'MDT', color: '#e56d6d' },
+    { match: 'HIGH', color: '#ff66ff' },
+  ],
+};
+
+export function AppShell() {
+  const [prefs, setPrefs] = useState<ShellPrefs>(DEFAULT_PREFS);
+  const [hydrated, setHydrated] = useState(false);
+
+  // Panel / drawer visibility
+  const [menuOpen, setMenuOpen] = useState(false);
+  const [settingsOpen, setSettingsOpen] = useState(false);
+  const [drawerOpen, setDrawerOpen] = useState(false);
+
+  // Warning selection
+  const [selectedWarning, setSelectedWarning] = useState<WarningAlert | null>(null);
+  const [focus, setFocus] = useState<MapFocus | null>(null);
+  const [announcement, setAnnouncement] = useState<{ id: string; text: string; tone: 'red' | 'amber' | 'blue' } | null>(null);
+
+  // Live map center, used by location-aware panels (METAR, hyperlocal).
+  const [mapCenter, setMapCenter] = useState<{ lat: number; lon: number }>({ lat: 34.836, lon: -92.262 });
+
+  // Tool surfaces
+  const [assistantOpen, setAssistantOpen] = useState(false);
+  const [metarOpen, setMetarOpen] = useState(false);
+  const [spotterOpen, setSpotterOpen] = useState(false);
+  const [spotterReports, setSpotterReports] = useState<SpotterReport[]>([]);
+  const [hyperlocalOpen, setHyperlocalOpen] = useState(false);
+
+  // Outlook extras
+  const [outlookDay, setOutlookDay] = useState<OutlookDay>('Day 1');
+  const [outlookGeoJson, setOutlookGeoJson] = useState<any>(null);
+  const [outlookMeta, setOutlookMeta] = useState<string | undefined>(undefined);
+  const [outlookLabel, setOutlookLabel] = useState('—');
+  const [outlookFill, setOutlookFill] = useState(0.25);
+  const [outlookOutline, setOutlookOutline] = useState(0.9);
+
+  const focusKey = useRef(1);
+  const announcedRef = useRef<Set<string>>(new Set());
+  const [favorites, setFavorites] = useState<string[]>(['KLZK', 'KSRX', 'KNQA']);
+
+  // ---- Hydrate prefs from localStorage ----------------------------------
+  useEffect(() => {
+    setPrefs(loadPrefs());
+    setHydrated(true);
+  }, []);
+
+  useEffect(() => {
+    if (hydrated) savePrefs(prefs);
+  }, [prefs, hydrated]);
+
+  const patch = useCallback((p: Partial<ShellPrefs>) => setPrefs((prev) => ({ ...prev, ...p })), []);
+
+  // ---- Category + active product ---------------------------------------
+  const category: NavCategory = prefs.category;
+  const productCategory: ProductCategory = NAV_TO_PRODUCT_CATEGORY[category];
+  const productField = productIdFieldFor(productCategory);
+  const activeProductId = (productField ? (prefs[productField] as string) : 'ref') || 'ref';
+  const product = getProduct(activeProductId) || getProduct('ref')!;
+
+  const selectProduct = useCallback(
+    (id: string) => {
+      const f = productIdFieldFor(productCategory);
+      if (f) patch({ [f]: id } as Partial<ShellPrefs>);
+    },
+    [productCategory, patch]
+  );
+
+  // ---- Radar site + resolved tile URL -----------------------------------
+  const site = RADAR_SITES.find((s) => s.id === prefs.radarSite || s.radarId === prefs.radarSite) || RADAR_SITES[0];
+  const baseTileUrl = useMemo(() => resolveTileUrl(product, site.radarId), [product, site.radarId]);
+  const frameTileUrl = useMemo(() => {
+    if (!product.loopAvailable || !baseTileUrl) return undefined;
+    // If the template already carries a {stamp} placeholder, use it directly;
+    // otherwise insert the stamp before the {z} placeholder.
+    if (baseTileUrl.includes('{stamp}')) return baseTileUrl;
+    return baseTileUrl.replace('/{z}/{x}/{y}.png', '-{stamp}/{z}/{x}/{y}.png');
+  }, [product.loopAvailable, baseTileUrl]);
+
+  // ---- Playback ---------------------------------------------------------
+  const playback = usePlayback(product.updateIntervalMin || 5, frameTileUrl || baseTileUrl, FRAME_COUNT, {
+    speedMs: prefs.playbackSpeedMs,
+  });
+  const isOutlook = productCategory === 'outlook';
+  const activeTileUrl = isOutlook ? undefined : playback.currentFrame?.tileUrl || baseTileUrl;
+
+  // ---- Warnings ---------------------------------------------------------
+  const { alerts, loading, error, lastUpdated, newIds, reload } = useWarnings({ intervalMs: 60000 });
+
+  // ---- Lightning (only while enabled) -----------------------------------
+  const strikes = useLightning(Boolean(prefs.overlays.lightning));
+  const lightningGeoJson = useMemo(() => {
+    if (!prefs.overlays.lightning) return undefined;
+    return {
+      type: 'FeatureCollection',
+      features: strikes.slice(-1500).map((s) => ({
+        type: 'Feature',
+        geometry: { type: 'Point', coordinates: [s.lon, s.lat] },
+        properties: {},
+      })),
+    };
+  }, [strikes, prefs.overlays.lightning]);
+
+  // ---- Storm reports ----------------------------------------------------
+  const [reportsGeoJson, setReportsGeoJson] = useState<any>(undefined);
+  useEffect(() => {
+    if (!prefs.overlays.stormReports) {
+      setReportsGeoJson(undefined);
+      return;
+    }
+    let cancelled = false;
+    async function load() {
+      try {
+        const res = await fetch('/api/lsr', { cache: 'no-store' });
+        const data = await res.json();
+        if (!cancelled) setReportsGeoJson(data);
+      } catch {}
+    }
+    load();
+    const t = setInterval(load, 120000);
+    return () => {
+      cancelled = true;
+      clearInterval(t);
+    };
+  }, [prefs.overlays.stormReports]);
+
+  // Merge community-submitted spotter reports into the map's report layer so
+  // they appear immediately, ahead of the next server refresh.
+  const mergedReportsGeoJson = useMemo(() => {
+    if (!spotterReports.length) return reportsGeoJson;
+    const base = reportsGeoJson?.features ? reportsGeoJson : { type: 'FeatureCollection', features: [] };
+    const local = spotterReports.map((r) => ({
+      type: 'Feature',
+      geometry: { type: 'Point', coordinates: [r.lon, r.lat] },
+      properties: {
+        id: r.id,
+        type: r.hazardType,
+        hazardType: r.hazardType,
+        text: r.description,
+        time: r.timestamp,
+        source: 'community',
+      },
+    }));
+    return { ...base, features: [...base.features, ...local] };
+  }, [reportsGeoJson, spotterReports]);
+
+  // ---- METAR stations ---------------------------------------------------
+  const [metarGeoJson, setMetarGeoJson] = useState<any>(undefined);
+  useEffect(() => {
+    if (!prefs.overlays.metars) {
+      setMetarGeoJson(undefined);
+      return;
+    }
+    let cancelled = false;
+    async function load() {
+      try {
+        const res = await fetch('/api/metar/geojson', { cache: 'no-store' });
+        const data = await res.json();
+        if (!cancelled) setMetarGeoJson(data);
+      } catch {}
+    }
+    load();
+    const t = setInterval(load, 300000);
+    return () => {
+      cancelled = true;
+      clearInterval(t);
+    };
+  }, [prefs.overlays.metars]);
+
+  // ---- Outlook vector data ---------------------------------------------
+  useEffect(() => {
+    if (!isOutlook) {
+      setOutlookGeoJson(null);
+      return;
+    }
+    let cancelled = false;
+    async function load() {
+      try {
+        const res = await fetch(`/api/outlooks?product=${product.id.replace('spc_', '')}&day=${encodeURIComponent(outlookDay)}`);
+        const data = await res.json();
+        if (cancelled) return;
+        if (data?._meta?.ok) {
+          setOutlookGeoJson(data);
+          setOutlookMeta(`${data._meta.attribution} · issued ${new Date(data._meta.fetchedAt).toUTCString().slice(0, 16)}`);
+        } else {
+          setOutlookGeoJson(null);
+          setOutlookMeta(data?._meta?.error || 'Outlook not published for this period.');
+        }
+      } catch {
+        if (!cancelled) setOutlookMeta('Outlook feed unavailable.');
+      }
+    }
+    load();
+    return () => {
+      cancelled = true;
+    };
+  }, [isOutlook, product.id, outlookDay]);
+
+  // ---- Announcements, sound, and speech for new warnings ----------------
+  useEffect(() => {
+    if (!newIds.size) return;
+    const newest = alerts.find((a) => newIds.has(a.id));
+    if (!newest) return;
+
+    setAnnouncement({
+      id: newest.id,
+      text: `${newest.event} issued for ${newest.areaDesc || 'the affected area'}.`,
+      tone: newest.event.includes('Tornado') ? 'red' : 'amber',
+    });
+
+    if (announcedRef.current.has(newest.id)) return;
+    announcedRef.current.add(newest.id);
+
+    if (prefs.soundAlerts) {
+      try {
+        const AudioCtx = window.AudioContext || (window as any).webkitAudioContext;
+        const ctx = new AudioCtx();
+        const osc = ctx.createOscillator();
+        const gain = ctx.createGain();
+        osc.type = 'sine';
+        osc.frequency.setValueAtTime(1050, ctx.currentTime);
+        gain.gain.setValueAtTime(0.001, ctx.currentTime);
+        gain.gain.exponentialRampToValueAtTime(0.25, ctx.currentTime + 0.1);
+        gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 2.5);
+        osc.connect(gain);
+        gain.connect(ctx.destination);
+        osc.start();
+        osc.stop(ctx.currentTime + 2.5);
+      } catch {}
+    }
+
+    if (prefs.spokenAlerts && typeof window !== 'undefined' && 'speechSynthesis' in window) {
+      const utter = new SpeechSynthesisUtterance(
+        `The National Weather Service has issued a ${newest.event} for ${newest.areaDesc}.`
+      );
+      utter.rate = 0.95;
+      window.speechSynthesis.speak(utter);
+    }
+  }, [newIds, alerts, prefs.soundAlerts, prefs.spokenAlerts]);
+
+  // ---- Handlers ---------------------------------------------------------
+  const pushFocus = useCallback((lon: number, lat: number, zoom: number) => {
+    focusKey.current += 1;
+    setFocus({ lon, lat, zoom, key: focusKey.current });
+  }, []);
+
+  const handleSelectLocation = useCallback(
+    (r: GeoResult) => {
+      pushFocus(r.lon, r.lat, r.kind === 'radar' ? 7.5 : 9);
+      if (r.nearestRadar) {
+        const match = RADAR_SITES.find((s) => s.radarId === r.nearestRadar);
+        if (match) patch({ radarSite: match.id });
+      }
+      setFavorites((prev) => (prev.includes(r.nearestRadar || r.label) ? prev : [...prev, r.nearestRadar || r.label].slice(-8)));
+    },
+    [pushFocus, patch]
+  );
+
+  const handleSelectWarning = useCallback(
+    (w: WarningAlert) => {
+      setSelectedWarning(w);
+      const c = warningCentroid(w);
+      if (c) pushFocus(c.lon, c.lat, 9);
+    },
+    [pushFocus]
+  );
+
+  const handleLocateMe = useCallback(() => {
+    if (!('geolocation' in navigator)) return;
+    navigator.geolocation.getCurrentPosition(
+      (pos) => pushFocus(pos.coords.longitude, pos.coords.latitude, 9),
+      () => {},
+      { enableHighAccuracy: false, timeout: 8000 }
+    );
+  }, [pushFocus]);
+
+  const handleSubmitSpotterReport = useCallback((report: SpotterReport) => {
+    setSpotterReports((prev) => [...prev, report]);
+    // Persist to the server so the report survives a reload and joins the
+    // community report feed. Failures are non-fatal to the local submission.
+    fetch('/api/spotter', {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify(report),
+    }).catch(() => {});
+  }, []);
+
+  const toggleOverlay = useCallback(
+    (key: keyof ShellPrefs['overlays'], value: boolean) =>
+      patch({ overlays: { ...prefs.overlays, [key]: value } }),
+    [prefs.overlays, patch]
+  );
+
+  // ---- Control props shared by every product panel ---------------------
+  const controlProps: ControlProps = {
+    product,
+    onSelectProduct: selectProduct,
+    radarSite: prefs.radarSite,
+    onSelectSite: (id) => patch({ radarSite: id }),
+    tilt: prefs.tilt,
+    onSelectTilt: (t) => patch({ tilt: t }),
+    opacity: prefs.opacity,
+    onChangeOpacity: (v) => patch({ opacity: v }),
+    smoothing: prefs.smoothing,
+    onToggleSmoothing: (v) => patch({ smoothing: v }),
+    overlays: prefs.overlays,
+    onToggleOverlay: toggleOverlay,
+  };
+
+  const timestampLabel = playback.currentFrame
+    ? new Date(playback.currentFrame.time).toUTCString().slice(17, 25) + ' UTC'
+    : '';
+
+  // 3D Radar is not yet implemented; fall back to Radar with an honest note.
+  const categoryLabel = category === '3D Radar' ? 'Radar (3D planned)' : category;
+
+  return (
+    <div className="relative h-screen w-screen overflow-hidden bg-[#070c14] font-sans select-none">
+      {/* Universal legend + announcement */}
+      <div className="absolute left-0 right-0 top-0 z-50">
+        <UniversalDataLegend
+          legend={product.legend}
+          availability={product.availability}
+          availabilityLabel={AVAILABILITY_LABEL[product.availability]}
+          sourceNote={product.sourceNote}
+          productLabel={product.label}
+          announcement={announcement}
+          onDismissAnnouncement={() => setAnnouncement(null)}
+        />
+      </div>
+
+      {/* Map workspace */}
+      <div className="absolute inset-0">
+        <RadarMap
+          tileUrl={activeTileUrl}
+          mode={category}
+          radarSite={prefs.radarSite}
+          basemap={prefs.basemap}
+          opacity={prefs.opacity}
+          smoothing={prefs.smoothing}
+          overlays={prefs.overlays}
+          outlookGeoJson={outlookGeoJson}
+          outlookColors={product.id in OUTLOOK_COLORS ? OUTLOOK_COLORS[product.id] : undefined}
+          lightningGeoJson={lightningGeoJson}
+          reportsGeoJson={mergedReportsGeoJson}
+          metarGeoJson={metarGeoJson}
+          focus={focus}
+          onCameraChange={(c) => setMapCenter({ lat: c.lat, lon: c.lon })}
+          onSelectSite={(id) => patch({ radarSite: id })}
+          onOutlookFeatureClick={(props) =>
+            setOutlookLabel(props.LABEL || props.label || props.category || 'Outlook area')
+          }
+        />
+      </div>
+
+      {/* Top navigation */}
+      <TopNavigation
+        activeCategory={category}
+        onSelectCategory={(c) => {
+          patch({ category: c });
+          setSelectedWarning(null);
+        }}
+        warningCount={alerts.length}
+        warningDrawerOpen={drawerOpen}
+        onToggleWarningDrawer={() => setDrawerOpen((v) => !v)}
+        onToggleMainMenu={() => setMenuOpen((v) => !v)}
+        onSelectLocation={handleSelectLocation}
+      />
+
+      {/* Floating product panel */}
+      <FloatingProductPanel
+        categoryLabel={categoryLabel}
+        product={product}
+        frames={playback.frames}
+        index={playback.index}
+        playing={playback.playing}
+        isLive={playback.isLive}
+        speedMs={prefs.playbackSpeedMs}
+        loopAvailable={Boolean(product.loopAvailable)}
+        timestampLabel={timestampLabel}
+        onTogglePlay={playback.togglePlay}
+        onStep={playback.step}
+        onScrub={playback.setIndex}
+        onGoLive={playback.goLive}
+        onSpeedChange={(ms) => patch({ playbackSpeedMs: ms })}
+      >
+        {(productCategory === 'radar' || productCategory === '3d') && <RadarControls {...controlProps} />}
+        {productCategory === 'composite' && <CompositeControls {...controlProps} />}
+        {productCategory === 'satellite' && <SatelliteControls {...controlProps} />}
+        {productCategory === 'model' && <ModelControls {...controlProps} />}
+        {productCategory === 'outlook' && (
+          <OutlookControls
+            {...controlProps}
+            day={outlookDay}
+            onSelectDay={setOutlookDay}
+            fillOpacity={outlookFill}
+            onChangeFillOpacity={setOutlookFill}
+            outlineOpacity={outlookOutline}
+            onChangeOutlineOpacity={setOutlookOutline}
+            outlookLabel={outlookLabel}
+            outlookMeta={outlookMeta}
+          />
+        )}
+      </FloatingProductPanel>
+
+      {/* Right-side warning drawer */}
+      <WarningDrawer
+        open={drawerOpen}
+        onClose={() => setDrawerOpen(false)}
+        alerts={alerts}
+        newIds={newIds}
+        loading={loading}
+        error={error}
+        lastUpdated={lastUpdated}
+        selectedId={selectedWarning?.id ?? null}
+        onSelect={handleSelectWarning}
+      />
+
+      {/* Independent floating warning details on the map */}
+      <WarningMapDetails warning={selectedWarning} onClose={() => setSelectedWarning(null)} />
+
+      {/* Main menu */}
+      <MainMenuDrawer
+        open={menuOpen}
+        onClose={() => setMenuOpen(false)}
+        overlays={prefs.overlays}
+        onToggleOverlay={toggleOverlay}
+        onOpenSettings={() => setSettingsOpen(true)}
+        onResetConus={() => pushFocus(-98.5795, 39.8283, 4.4)}
+        onLocateMe={handleLocateMe}
+        onOpenAssistant={() => setAssistantOpen(true)}
+        onOpenMetars={() => setMetarOpen(true)}
+        onOpenSpotterReport={() => setSpotterOpen(true)}
+        onOpenHyperlocal={() => setHyperlocalOpen(true)}
+        favorites={favorites}
+        onSelectFavorite={(id) => {
+          const match = RADAR_SITES.find((s) => s.id === id || s.radarId === id);
+          if (match) {
+            patch({ radarSite: match.id });
+            pushFocus(match.lon, match.lat, 7.5);
+          }
+        }}
+      />
+
+      {/* Settings workspace */}
+      <SettingsWorkspace
+        open={settingsOpen}
+        onClose={() => setSettingsOpen(false)}
+        prefs={prefs}
+        onChange={patch}
+        onReset={() => {
+          clearPrefs();
+          setPrefs(DEFAULT_PREFS);
+        }}
+      />
+
+      {/* Live METAR / surface observation panel */}
+      {metarOpen && <METARPanel center={mapCenter} onClose={() => setMetarOpen(false)} />}
+
+      {/* AI Weather Assistant */}
+      {assistantOpen && (
+        <WeatherAssistant
+          context={{
+            site: site.radarId,
+            product: product.label,
+            alerts: alerts.map((a) => a.event),
+          }}
+          onClose={() => setAssistantOpen(false)}
+        />
+      )}
+
+      {/* Spotter report submission */}
+      {spotterOpen && (
+        <SpotterReportModal
+          currentCoords={[mapCenter.lon, mapCenter.lat]}
+          onClose={() => setSpotterOpen(false)}
+          onSubmit={handleSubmitSpotterReport}
+        />
+      )}
+
+      {/* Neighborhood / hyperlocal intelligence */}
+      {hyperlocalOpen && (
+        <HyperlocalDashboardModal
+          lat={mapCenter.lat}
+          lon={mapCenter.lon}
+          siteName={`Near ${mapCenter.lat.toFixed(2)}°N, ${Math.abs(mapCenter.lon).toFixed(2)}°W`}
+          onClose={() => setHyperlocalOpen(false)}
+        />
+      )}
+    </div>
+  );
+}
