+export const AVAILABILITY_LABEL: Record<ProductAvailability, string> = {
+  live: 'Live',
+  proxy: 'Proxy data',
+  experimental: 'Experimental',
+  planned: 'Planned',
+};
+
+export const AVAILABILITY_STYLE: Record<ProductAvailability, string> = {
+  live: 'border-emerald-500/40 bg-emerald-500/10 text-emerald-300',
+  proxy: 'border-amber-500/40 bg-amber-500/10 text-amber-300',
+  experimental: 'border-fuchsia-500/40 bg-fuchsia-500/10 text-fuchsia-300',
+  planned: 'border-slate-600 bg-slate-800/60 text-slate-400',
+};
+
+/** Replace the {site} placeholder in a tile template with a radar callsign. */
+export function resolveTileUrl(product: ProductDef, site: string): string | undefined {
+  if (!product.tileUrl) return undefined;
+  return product.tileUrl.replace('{site}', site);
+}
