+    { value: '65+ kft (overshoot)', color: '#ffffff' },
+  ],
+};
+
+const VIL_LEGEND: LegendSpec = {
+  kind: 'gradient',
+  title: 'Vertically Integrated Liquid',
+  unit: 'kg/m²',
+  stops: [
+    { value: '5 (light)', color: '#04e9e7' },
+    { value: '15 (moderate)', color: '#02fd02' },
+    { value: '30 (heavy)', color: '#fdf802' },
+    { value: '45 (severe)', color: '#fd9500' },
+    { value: '60+ (hail core)', color: '#fd0000' },
