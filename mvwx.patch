+'use client';
+
+import { getProductsByCategory, AVAILABILITY_LABEL } from '../../../lib/product-config';
+import type { OutlookDay } from '../../../lib/shell/types';
+import { Field, PanelSection, Select, Slider, EmptyNote, Badge } from '../ui';
+import type { ControlProps } from './RadarControls';
+
+const DAYS: OutlookDay[] = ['Day 1', 'Day 2', 'Day 3'];
+
+export type OutlookControlProps = ControlProps & {
+  day: OutlookDay;
+  onSelectDay: (d: OutlookDay) => void;
+  fillOpacity: number;
+  onChangeFillOpacity: (v: number) => void;
+  outlineOpacity: number;
+  onChangeOutlineOpacity: (v: number) => void;
+  outlookLabel: string;
+  outlookMeta?: string;
+};
+
+export function OutlookControls({
+  product,
+  onSelectProduct,
+  day,
+  onSelectDay,
+  fillOpacity,
+  onChangeFillOpacity,
+  outlineOpacity,
+  onChangeOutlineOpacity,
+  outlookLabel,
+  outlookMeta,
+}: OutlookControlProps) {
+  const products = getProductsByCategory('outlook');
+  // Tornado/wind/hail probability layers are not published for Day 3.
+  const availableForDay = products.filter((p) => {
+    if (day === 'Day 3') return p.id === 'spc_cat';
+    return true;
+  });
+
+  return (
+    <>
+      <PanelSection title="Outlook Provider">
+        <Field label="Agency">
+          <Select value="SPC" onChange={() => {}}>
+            <option value="SPC">Storm Prediction Center (SPC)</option>
+          </Select>
+        </Field>
+        <Field label="Product" hint={AVAILABILITY_LABEL[product.availability]}>
+          <Select value={product.id} onChange={(e) => onSelectProduct(e.target.value)}>
+            {availableForDay.map((p) => (
+              <option key={p.id} value={p.id}>
+                {p.label}
+              </option>
+            ))}
+          </Select>
+        </Field>
+      </PanelSection>
+
+      <PanelSection title="Forecast Period">
+        <div className="grid grid-cols-3 gap-1">
+          {DAYS.map((d) => (
+            <button
+              key={d}
+              onClick={() => onSelectDay(d)}
+              className={`rounded-lg py-1 text-[11px] font-bold transition ${
+                day === d ? 'bg-cyan-500 text-slate-950' : 'bg-slate-900 text-slate-400 hover:text-white'
+              }`}
+            >
+              {d}
+            </button>
+          ))}
+        </div>
+        {outlookMeta && <p className="text-[10px] text-slate-500">{outlookMeta}</p>}
+      </PanelSection>
+
+      <PanelSection title="Display">
+        <Field label="Fill Opacity" hint={`${Math.round(fillOpacity * 100)}%`}>
+          <Slider value={fillOpacity} min={0} max={1} step={0.05} onChange={onChangeFillOpacity} ariaLabel="Outlook fill opacity" />
+        </Field>
+        <Field label="Outline Opacity" hint={`${Math.round(outlineOpacity * 100)}%`}>
+          <Slider value={outlineOpacity} min={0} max={1} step={0.05} onChange={onChangeOutlineOpacity} ariaLabel="Outlook outline opacity" />
+        </Field>
+      </PanelSection>
+
+      <PanelSection title="Selected Area">
+        <div className="flex flex-wrap gap-1">
+          <Badge tone="cyan">{outlookLabel}</Badge>
+        </div>
+        <p className="text-[10px] leading-snug text-slate-500">
+          Click an outlook polygon on the map to inspect its category, probability and validity.
+        </p>
+      </PanelSection>
+    </>
+  );
+}
