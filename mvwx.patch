+// ============================================================================
+// MesoVortexWX — Data-Driven Product Configuration
+// ----------------------------------------------------------------------------
+// Every product (radar, composite, satellite, model, outlook) declares its own
+// available selections, color scale, units, legend formatting, playback
+// behaviour, data source, availability and update interval here. The UI reads
+// from this registry so panels and the universal legend stay in sync and never
+// advertise data that does not exist.
+// ============================================================================
+
+export type ProductCategory = 'radar' | '3d' | 'composite' | 'satellite' | 'model' | 'outlook';
+
+export type LegendKind = 'gradient' | 'categorical';
+
+export type LegendStop = {
+  /** Numeric or categorical value used for the tooltip readout. */
+  value: string;
+  /** Short label rendered on the categorical chip (ignored for gradients). */
+  short?: string;
+  color: string;
+};
+
+export type LegendSpec = {
+  kind: LegendKind;
+  title: string;
+  unit?: string;
+  stops: LegendStop[];
+  /** Human-readable note about the scale semantics. */
+  note?: string;
+};
+
+export type DataSourceKind =
+  | 'nexrad-level3'
+  | 'mrms'
+  | 'goes'
+  | 'model'
+  | 'spc'
+  | 'wpc'
+  | 'nhc'
+  | 'derived'
+  | 'none';
+
+export type ProductAvailability = 'live' | 'proxy' | 'experimental' | 'planned';
+
+export type ProductDef = {
+  id: string;
+  category: ProductCategory;
+  label: string;
+  /** Short code used in compact UI (3-4 chars). */
+  short: string;
+  description: string;
+  legend: LegendSpec;
+  sourceKind: DataSourceKind;
+  availability: ProductAvailability;
+  /** Approximate data refresh cadence in minutes; undefined = not applicable. */
+  updateIntervalMin?: number;
+  /** Tile template with {z}/{x}/{y} placeholders, when the product is a raster. */
+  tileUrl?: string;
+  /** Note shown to the user about provenance or limitations. */
+  sourceNote?: string;
+  /** Attribution string surfaced in the UI. */
+  attribution?: string;
+  /** True when historical frame stepping is authoritative for this product. */
+  loopAvailable?: boolean;
+};
+
+const IEM = 'https://mesonet.agron.iastate.edu/cache/tile.py/1.0.0';
+const IEM_ATTR = 'Iowa Environmental Mesonet (IEM) · NOAA NEXRAD / MRMS / NESDIS';
+
+// ---------------------------------------------------------------------------
+// Shared legend scales
+// ---------------------------------------------------------------------------
+
+const DBZ_LEGEND: LegendSpec = {
+  kind: 'gradient',
+  title: 'Reflectivity',
+  unit: 'dBZ',
