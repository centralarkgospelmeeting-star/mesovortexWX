+++ b/app/api/boundaries/route.ts
@@ -0,0 +1,54 @@
+import { NextResponse } from 'next/server';
+import { feature } from 'topojson-client';
+
+export const dynamic = 'force-dynamic';
+
+// Boundary GeoJSON proxies. The IEM boundary endpoints were retired, so these
+// point at stable public mirrors. Counties arrive as TopoJSON and are converted
+// server-side to keep the payload small enough to cache.
+const SOURCES: Record<string, { url: string; attribution: string; topo?: string }> = {
+  states: {
+    url: 'https://cdn.jsdelivr.net/gh/PublicaMundi/MappingAPI@master/data/geojson/us-states.json',
+    attribution: 'PublicaMundi / US Census TIGER',
+  },
+  counties: {
+    url: 'https://cdn.jsdelivr.net/npm/us-atlas@3/counties-10m.json',
+    attribution: 'US Census TIGER / us-atlas',
+    topo: 'counties',
+  },
+};
+
+export async function GET(request: Request) {
+  const { searchParams } = new URL(request.url);
+  const kind = searchParams.get('kind') || 'states';
+  const src = SOURCES[kind];
+
+  if (!src) {
+    return NextResponse.json(
+      { type: 'FeatureCollection', features: [], _meta: { ok: false, error: 'Unknown boundary kind' } },
+      { headers: { 'Cache-Control': 'no-store' } }
+    );
+  }
+
+  try {
+    const res = await fetch(src.url, { next: { revalidate: 604800 } });
+    if (!res.ok) throw new Error(`Upstream HTTP ${res.status}`);
+    const raw = await res.json();
+
+    const data = src.topo ? (feature(raw, raw.objects[src.topo]) as any) : raw;
+
+    return NextResponse.json(
+      { ...data, _meta: { ok: true, source: src.url, attribution: src.attribution } },
+      { headers: { 'Cache-Control': 'public, max-age=604800, stale-while-revalidate=2592000' } }
+    );
+  } catch (e: any) {
+    return NextResponse.json(
+      {
+        type: 'FeatureCollection',
+        features: [],
+        _meta: { ok: false, source: src.url, error: e?.message || 'Boundary fetch failed' },
+      },
+      { headers: { 'Cache-Control': 'no-store' } }
+    );
+  }
+}
diff --git a/app/api/geocode/route.ts b/app/api/geocode/route.ts
new file mode 100644
index 0000000..5df7518
--- /dev/null
+++ b/app/api/geocode/route.ts
@@ -0,0 +1,121 @@
+import { NextResponse } from 'next/server';
+import { RADAR_SITES } from '@/lib/radar-config';
+
+export const dynamic = 'force-dynamic';
+
+export type GeoResult = {
+  label: string;
+  detail: string;
+  lat: number;
+  lon: number;
+  /** Nearest radar callsign when the result maps to a radar-appropriate point. */
+  nearestRadar?: string;
+  kind: 'radar' | 'city' | 'coordinate';
+};
+
+function nearestRadar(lat: number, lon: number): string | undefined {
+  let best: { id: string; d: number } | null = null;
+  for (const s of RADAR_SITES) {
+    if (s.network !== 'NEXRAD') continue;
+    const d = (s.lat - lat) ** 2 + (s.lon - lon) ** 2;
+    if (!best || d < best.d) best = { id: s.radarId, d };
+  }
+  return best?.id;
+}
+
+export async function GET(request: Request) {
+  const { searchParams } = new URL(request.url);
+  const q = (searchParams.get('q') || '').trim();
+
+  if (!q) {
+    return NextResponse.json({ results: [] }, { headers: { 'Cache-Control': 'no-store' } });
+  }
+
+  const results: GeoResult[] = [];
+
+  // 1. Coordinate pair: "35.3,-97.2"
+  const coordMatch = q.match(/^(-?\d{1,3}(?:\.\d+)?)\s*,\s*(-?\d{1,3}(?:\.\d+)?)$/);
+  if (coordMatch) {
+    const lat = parseFloat(coordMatch[1]);
+    const lon = parseFloat(coordMatch[2]);
+    if (lat >= -90 && lat <= 90 && lon >= -180 && lon <= 180) {
+      results.push({
+        label: `${lat.toFixed(3)}, ${lon.toFixed(3)}`,
+        detail: 'Geographic coordinates',
+        lat,
+        lon,
+        nearestRadar: nearestRadar(lat, lon),
+        kind: 'coordinate',
+      });
+    }
+  }
+
+  // 2. Radar station identifier (e.g. "KLZK" or "LZK")
+  const upper = q.toUpperCase();
+  const station = RADAR_SITES.find(
+    (s) => s.id === upper || s.radarId === upper || s.id === `K${upper}`
+  );
+  if (station) {
+    results.push({
+      label: `${station.id} — ${station.name}`,
+      detail: `${station.network} radar site`,
+      lat: station.lat,
+      lon: station.lon,
+      nearestRadar: station.radarId,
+      kind: 'radar',
+    });
+  }
+
+  // 3. City / state / ZIP / address via Nominatim (OSM). Used server-side with
+  //    a proper User-Agent and cached for a day, so request volume stays well
+  //    within the public usage policy.
+  try {
+    const url =
+      `https://nominatim.openstreetmap.org/search?q=${encodeURIComponent(q)}` +
+      `&format=json&limit=5&addressdetails=1&countrycodes=us,ca,mx`;
+    const res = await fetch(url, {
+      headers: {
+        'User-Agent': 'MesoVortexWX/2.0 (contact@mesovortexwx.internal)',
+        Accept: 'application/json',
+      },
+      next: { revalidate: 86400 },
+    });
+    if (res.ok) {
+      const matches: any[] = await res.json();
+      for (const m of matches) {
+        const lat = parseFloat(m.lat);
+        const lon = parseFloat(m.lon);
+        if (Number.isNaN(lat) || Number.isNaN(lon)) continue;
+        const addr = m.address || {};
+        const detail =
+          [addr.city || addr.town || addr.village || addr.county, addr.state]
+            .filter(Boolean)
+            .join(', ') || m.type || 'Location';
+        results.push({
+          label: m.display_name?.split(',').slice(0, 2).join(',') || q,
+          detail,
+          lat,
+          lon,
+          nearestRadar: nearestRadar(lat, lon),
+          kind: 'city',
+        });
+      }
+    }
+  } catch {
+    // Geocoder is best-effort; radar + coordinate matches still work.
+  }
+
+  // De-duplicate by rounded coordinates.
+  const seen = new Set<string>();
+  const unique = results.filter((r) => {
+    const key = `${r.lat.toFixed(3)},${r.lon.toFixed(3)}`;
+    if (seen.has(key)) return false;
+    seen.add(key);
+    return true;
+  });
+
+  return NextResponse.json(
+    { results: unique.slice(0, 8) },
+    { headers: { 'Cache-Control': 'public, max-age=300, stale-while-revalidate=3600' } }
+  );
+}
