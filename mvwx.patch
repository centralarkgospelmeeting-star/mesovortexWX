+                          ? 'border-blue-500 bg-blue-950/40 text-blue-200'
+                          : 'border-slate-800 bg-slate-900 text-slate-400'
+                      }`}
+                    >
+                      {b.label}
+                    </button>
+                  ))}
+                </div>
+              </Field>
+              <Field label="Geographic boundaries">
+                <div className="space-y-2">
+                  <Checkbox label="State boundaries" checked={prefs.overlays.states} onChange={(v) => setOverlay('states', v)} />
+                  <Checkbox label="County boundaries" checked={prefs.overlays.counties} onChange={(v) => setOverlay('counties', v)} />
+                  <Checkbox label="Radar site markers" checked={prefs.overlays.radarSites} onChange={(v) => setOverlay('radarSites', v)} />
+                </div>
