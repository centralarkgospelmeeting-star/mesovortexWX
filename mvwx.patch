+  overlays: OverlayState;
+  playbackSpeedMs: number;
+  units: 'imperial' | 'metric';
+  reduceMotion: boolean;
+  soundAlerts: boolean;
+  spokenAlerts: boolean;
+  mapCenter?: { lon: number; lat: number; zoom: number };
+};
+
+export const DEFAULT_PREFS: ShellPrefs = {
+  schemaVersion: 3,
+  category: 'Radar',
+  radarProductId: 'ref',
+  compositeProductId: 'comp_ref',
+  satelliteProductId: 'sat_vis',
+  modelProductId: 'mdl_ref',
+  outlookProductId: 'spc_cat',
+  radarSite: 'KLZK',
+  tilt: '0.5',
+  basemap: 'satellite-streets',
+  opacity: 0.85,
+  smoothing: true,
+  overlays: DEFAULT_OVERLAYS,
+  playbackSpeedMs: 450,
+  units: 'imperial',
+  reduceMotion: false,
+  soundAlerts: false,
+  spokenAlerts: false,
+  mapCenter: undefined,
+};
+
+/** Which product id field in prefs corresponds to a nav category. */
+export function productIdFieldFor(category: ProductCategory): keyof ShellPrefs | null {
+  switch (category) {
+    case 'radar':
+    case '3d':
+      return 'radarProductId';
+    case 'composite':
+      return 'compositeProductId';
+    case 'satellite':
+      return 'satelliteProductId';
+    case 'model':
+      return 'modelProductId';
+    case 'outlook':
+      return 'outlookProductId';
+    default:
+      return null;
+  }
+}
diff --git a/lib/shell/usePlayback.ts b/lib/shell/usePlayback.ts
new file mode 100644
index 0000000..50dfc82
--- /dev/null
+++ b/lib/shell/usePlayback.ts
@@ -0,0 +1,124 @@
+'use client';
+
+import { useCallback, useEffect, useMemo, useRef, useState } from 'react';
+
+export type PlaybackFrame = {
+  /** ISO timestamp for the frame. */
+  time: string;
+  label: string;
+  /** Tile template for the frame, when historical stepping is available. */
+  tileUrl?: string;
+  ageMinutes: number;
+};
+
+type Options = {
+  /** Cadence between frames in ms. */
+  speedMs: number;
+  /** When false, the loop stays on the last (live) frame. */
+  loopAvailable?: boolean;
+};
+
+/**
+ * Generates a rolling window of frames for a product given its update
+ * interval, then drives index/play state. The frames carry per-frame tile
+ * templates only when the source supports authoritative historical stepping;
+ * otherwise all frames point at the live tile and the loop is marked
+ * non-authoritative.
+ */
+export function usePlayback(
+  updateIntervalMin: number,
+  baseTileUrl: string | undefined,
+  frameCount: number,
+  options: Options
+) {
+  const { speedMs } = options;
+  const [index, setIndex] = useState(0);
+  const [playing, setPlaying] = useState(false);
+  const intervalRef = useRef<ReturnType<typeof setInterval> | null>(null);
+
+  const frames = useMemo<PlaybackFrame[]>(() => {
+    const count = Math.max(1, frameCount);
+    const stepMs = updateIntervalMin * 60 * 1000;
+    const now = Date.now();
+    const list: PlaybackFrame[] = [];
+
+    for (let i = count - 1; i >= 1; i--) {
+      const d = new Date(now - i * stepMs);
+      if (updateIntervalMin <= 15) {
+        // Snap to the nearest scan minute for short-interval products.
+        d.setUTCMinutes(Math.floor(d.getUTCMinutes() / updateIntervalMin) * updateIntervalMin, 0, 0);
+      } else {
+        d.setUTCMinutes(0, 0, 0);
+      }
+      const ageMinutes = Math.round((now - d.getTime()) / 60000);
+      const stamp = `${d.getUTCFullYear()}${String(d.getUTCMonth() + 1).padStart(2, '0')}${String(
+        d.getUTCDate()
+      ).padStart(2, '0')}${String(d.getUTCHours()).padStart(2, '0')}${String(d.getUTCMinutes()).padStart(2, '0')}`;
+
+      list.push({
+        time: d.toISOString(),
+        label: `-${ageMinutes}m`,
+        tileUrl: baseTileUrl ? baseTileUrl.replace('{stamp}', stamp) : undefined,
+        ageMinutes,
+      });
+    }
+
+    list.push({
+      time: new Date(now).toISOString(),
+      label: 'LIVE',
+      tileUrl: baseTileUrl,
+      ageMinutes: 0,
+    });
+
+    return list;
+  }, [updateIntervalMin, baseTileUrl, frameCount]);
+
+  // Keep the index pinned to the live frame whenever the frame set changes.
+  useEffect(() => {
+    setIndex(frames.length - 1);
+  }, [frames.length]);
+
+  useEffect(() => {
+    if (intervalRef.current) clearInterval(intervalRef.current);
+    if (!playing) return;
+    intervalRef.current = setInterval(() => {
+      setIndex((i) => (i + 1) % frames.length);
+    }, speedMs);
+    return () => {
+      if (intervalRef.current) clearInterval(intervalRef.current);
+    };
+  }, [playing, speedMs, frames.length]);
+
+  const currentFrame = frames[index] || frames[frames.length - 1];
+  const isLive = index === frames.length - 1;
+
+  const step = useCallback(
+    (dir: -1 | 1) => {
+      setIndex((i) => {
+        const next = i + dir;
+        if (next < 0) return frames.length - 1;
+        if (next >= frames.length) return 0;
+        return next;
+      });
+    },
+    [frames.length]
+  );
+
+  const goLive = useCallback(() => {
+    setPlaying(false);
+    setIndex(frames.length - 1);
+  }, [frames.length]);
+
+  return {
+    frames,
+    index,
+    setIndex,
+    playing,
+    setPlaying,
+    togglePlay: () => setPlaying((p) => !p),
+    step,
+    goLive,
+    currentFrame,
+    isLive,
+  };
+}
diff --git a/lib/shell/useWarnings.ts b/lib/shell/useWarnings.ts
new file mode 100644
index 0000000..8acc446
--- /dev/null
+++ b/lib/shell/useWarnings.ts
@@ -0,0 +1,112 @@
+'use client';
+
+import { useCallback, useEffect, useRef, useState } from 'react';
+
+export type WarningAlert = {
+  id: string;
+  event: string;
+  headline: string;
+  severity: string;
+  urgency?: string;
+  areaDesc: string;
+  sent?: string;
+  expires?: string;
+  wfo?: string;
+  geometry?: GeoJSON.Geometry | null;
+};
+
+type Options = {
+  /** Refresh interval in ms. Default 60s. */
+  intervalMs?: number;
+  enabled?: boolean;
+};
+
+function centroid(geometry: GeoJSON.Geometry | null | undefined): { lon: number; lat: number } | null {
+  if (!geometry) return null;
+  const ring = (coords: any): number[][] => {
+    if (Array.isArray(coords) && Array.isArray(coords[0]) && typeof coords[0][0] === 'number') {
+      return coords as number[][];
+    }
+    return [];
+  };
+  let points: number[][] = [];
+  if (geometry.type === 'Polygon') points = ring(geometry.coordinates[0]);
+  else if (geometry.type === 'MultiPolygon') points = ring(geometry.coordinates[0]?.[0]);
+  if (!points.length) return null;
+  let lon = 0;
+  let lat = 0;
+  for (const p of points) {
+    lon += p[0];
+    lat += p[1];
+  }
+  return { lon: lon / points.length, lat: lat / points.length };
+}
+
+export function warningCentroid(w: WarningAlert) {
+  return centroid(w.geometry);
+}
+
+/**
+ * Polls the app's /api/warnings route, which proxies api.weather.gov with a
+ * proper User-Agent. Returns normalised alerts plus the newest id so the UI
+ * can highlight newly issued warnings without re-announcing old ones.
+ */
+export function useWarnings({ intervalMs = 60000, enabled = true }: Options = {}) {
+  const [alerts, setAlerts] = useState<WarningAlert[]>([]);
+  const [loading, setLoading] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  const [lastUpdated, setLastUpdated] = useState<string | null>(null);
+  const seenIds = useRef<Set<string>>(new Set());
+  const [newIds, setNewIds] = useState<Set<string>>(new Set());
+
+  const load = useCallback(async () => {
+    setLoading(true);
+    try {
+      const res = await fetch('/api/warnings', { cache: 'no-store' });
+      if (!res.ok) throw new Error(`HTTP ${res.status}`);
+      const data = await res.json();
+      const features: any[] = data.features || [];
+
+      const items: WarningAlert[] = features
+        .filter((f) => f.properties?.event)
+        .map((f) => ({
+          id: f.id || f.properties?.id,
+          event: f.properties?.event || 'Weather Warning',
+          headline: f.properties?.headline || f.properties?.event || 'Active warning',
+          severity: f.properties?.severity || 'Unknown',
+          urgency: f.properties?.urgency,
+          areaDesc: f.properties?.areaDesc || '',
+          sent: f.properties?.sent,
+          expires: f.properties?.expires,
+          wfo: f.properties?.wfo || f.properties?.senderName,
+          geometry: f.geometry || null,
+        }));
+
+      const incomingNew = new Set<string>();
+      if (seenIds.current.size > 0) {
+        for (const item of items) {
+          if (!seenIds.current.has(item.id)) incomingNew.add(item.id);
+        }
+      }
+      items.forEach((i) => seenIds.current.add(i.id));
+      if (incomingNew.size) setNewIds(incomingNew);
+
+      setAlerts(items);
+      setLastUpdated(new Date().toISOString());
+      setError(null);
+    } catch (e: any) {
+      setError(e?.message || 'Failed to load warnings');
+    } finally {
+      setLoading(false);
+    }
+  }, []);
+
+  useEffect(() => {
+    if (!enabled) return;
+    load();
+    const timer = setInterval(load, intervalMs);
+    return () => clearInterval(timer);
+  }, [enabled, intervalMs, load]);
+
+  return { alerts, loading, error, lastUpdated, newIds, reload: load };
+}
