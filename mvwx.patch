new file mode 100644
index 0000000..7bb7f5c
--- /dev/null
+++ b/lib/shell/persistence.ts
@@ -0,0 +1,37 @@
+import { DEFAULT_PREFS, DEFAULT_OVERLAYS, type ShellPrefs } from './types';
+
+const STORAGE_KEY = 'mesovortexwx.shell.v3';
+
+function migrate(parsed: Partial<ShellPrefs>): ShellPrefs {
+  return {
+    ...DEFAULT_PREFS,
+    ...parsed,
+    schemaVersion: 3,
+    overlays: { ...DEFAULT_OVERLAYS, ...(parsed.overlays || {}) },
+  };
+}
+
+export function loadPrefs(): ShellPrefs {
+  if (typeof window === 'undefined') return DEFAULT_PREFS;
+  try {
+    const raw = window.localStorage.getItem(STORAGE_KEY);
+    if (!raw) return DEFAULT_PREFS;
+    return migrate(JSON.parse(raw) as Partial<ShellPrefs>);
+  } catch {
+    return DEFAULT_PREFS;
+  }
+}
+
+export function savePrefs(prefs: ShellPrefs) {
+  if (typeof window === 'undefined') return;
+  try {
+    window.localStorage.setItem(STORAGE_KEY, JSON.stringify({ ...prefs, schemaVersion: 3 }));
+  } catch {}
+}
+
+export function clearPrefs() {
+  if (typeof window === 'undefined') return;
+  try {
+    window.localStorage.removeItem(STORAGE_KEY);
+  } catch {}
+}
