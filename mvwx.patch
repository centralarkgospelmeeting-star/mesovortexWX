+export function getProduct(id: string): ProductDef | undefined {
+  return PRODUCTS.find((p) => p.id === id);
+}
+
+export function getProductsByCategory(category: ProductCategory): ProductDef[] {
+  return PRODUCTS.filter((p) => p.category === category);
+}
+
+export function getDefaultProduct(category: ProductCategory): ProductDef {
+  const list = getProductsByCategory(category);
+  return list[0] || PRODUCTS[0];
+}
+
+/** Categories that have at least one product available right now. */
+export const ACTIVE_CATEGORIES: ProductCategory[] = [
+  'radar',
+  '3d',
+  'composite',
+  'satellite',
+  'model',
+  'outlook',
+];
