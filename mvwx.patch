+  note: 'NEXRAD base reflectivity, 5 dBZ bins.',
+};
+
+const VELOCITY_LEGEND: LegendSpec = {
+  kind: 'gradient',
+  title: 'Velocity',
+  unit: 'kt',
+  stops: [
+    { value: '-80+ kt (extreme inbound)', color: '#00ffff' },
