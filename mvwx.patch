+'use client';
+
+import { useState } from 'react';
+import type { WarningAlert } from '../../lib/shell/useWarnings';
+
+type Props = {
+  warning: WarningAlert | null;
+  onClose: () => void;
+};
+
+/**
+ * A separate floating overlay on the map (NOT an expansion inside the warning
+ * drawer). Closing this does not close the drawer, so the user can keep the
+ * list open while examining a selected warning.
+ */
+export function WarningMapDetails({ warning, onClose }: Props) {
+  const [expanded, setExpanded] = useState(false);
+
+  if (!warning) return null;
+
+  const isTor = warning.event.includes('Tornado');
+  const isSvr = warning.event.includes('Severe Thunderstorm');
+  const badge = isTor ? 'bg-red-600 text-white' : isSvr ? 'bg-amber-400 text-slate-950' : 'bg-blue-600 text-white';
+
+  return (
+    <div className="absolute left-1/2 top-24 z-40 w-80 -translate-x-1/2 rounded-2xl border border-slate-700 bg-slate-950/96 p-4 font-sans text-slate-100 shadow-2xl backdrop-blur-2xl sm:left-auto sm:right-4 sm:translate-x-0 lg:right-[25rem]">
+      <div className="flex items-center justify-between border-b border-slate-800 pb-2.5">
+        <span className={`rounded-lg px-2 py-0.5 text-[10px] font-black uppercase ${badge}`}>{warning.event}</span>
+        <button
+          onClick={onClose}
+          aria-label="Close warning details"
+          className="rounded-lg bg-slate-800 p-1 text-xs text-slate-400 hover:text-white"
+        >
+          ✕
+        </button>
+      </div>
+
+      <div className="mt-3 space-y-2 text-xs">
+        <div>
+          <span className="text-[10px] font-bold uppercase text-slate-500">Headline</span>
+          <p className="text-xs font-bold leading-snug text-white">{warning.headline}</p>
+        </div>
+
+        <div className="grid grid-cols-2 gap-2 font-mono text-[11px]">
+          <div>
+            <span className="text-slate-500">Issuer:</span>{' '}
+            <b className="text-cyan-400">{warning.wfo || 'NWS'}</b>
+          </div>
+          <div>
+            <span className="text-slate-500">Severity:</span> <b className="text-white">{warning.severity}</b>
+          </div>
+        </div>
+
+        <div>
+          <span className="text-[10px] font-bold uppercase text-slate-500">Affected area</span>
+          <p className="text-[11px] leading-tight text-slate-300">{warning.areaDesc || '—'}</p>
+        </div>
+
+        {expanded && (
+          <div className="space-y-1.5 border-t border-slate-800 pt-2 font-mono text-[10px] text-slate-400">
+            <div>
+              <span className="text-slate-500">Issued:</span>{' '}
+              {warning.sent ? new Date(warning.sent).toLocaleString() : '—'}
+            </div>
+            <div>
+              <span className="text-slate-500">Expires:</span>{' '}
+              {warning.expires ? new Date(warning.expires).toLocaleString() : '—'}
+            </div>
+            <div>
+              <span className="text-slate-500">Urgency:</span> {warning.urgency || '—'}
+            </div>
+            <div className="text-slate-500">ID: {warning.id}</div>
+          </div>
+        )}
+
+        <button
+          onClick={() => setExpanded((v) => !v)}
+          className="w-full rounded-lg border border-slate-700 bg-slate-900 py-1.5 text-[11px] font-bold text-slate-200 hover:bg-slate-800"
+        >
+          {expanded ? 'Collapse details ▲' : 'Expand details ▼'}
+        </button>
+
+        <p className="text-[9px] leading-snug text-slate-500">
+          Official National Weather Service warning. Verify all safety decisions with NWS and local officials.
+        </p>
+      </div>
+    </div>
+  );
+}
