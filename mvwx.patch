+            <PanelSection title="Satellite defaults">
+              <Field label="Default imagery">
+                <Select value={prefs.satelliteProductId} onChange={(e) => onChange({ satelliteProductId: e.target.value })}>
+                  <option value="sat_vis">Visible (1 km)</option>
+                  <option value="sat_ir">Clean Infrared (4 km)</option>
+                  <option value="sat_wv">Water Vapor (4 km)</option>
+                </Select>
+              </Field>
+            </PanelSection>
+          )}
+
+          {category === 'Models' && (
+            <PanelSection title="Model defaults">
+              <Field label="Default variable">
+                <Select value={prefs.modelProductId} onChange={(e) => onChange({ modelProductId: e.target.value })}>
+                  <option value="mdl_ref">Simulated Reflectivity</option>
+                  <option value="mdl_temp">2 m Temperature</option>
+                  <option value="mdl_dewp">2 m Dew Point</option>
+                  <option value="mdl_cape">Surface CAPE</option>
+                  <option value="mdl_pwat">Precipitable Water</option>
+                  <option value="mdl_wind">10 m Wind Speed</option>
+                  <option value="mdl_qpf">Accumulated Precipitation</option>
+                </Select>
+              </Field>
+            </PanelSection>
+          )}
+
+          {category === 'Outlooks' && (
+            <PanelSection title="Outlook defaults">
+              <Field label="Default outlook product">
+                <Select value={prefs.outlookProductId} onChange={(e) => onChange({ outlookProductId: e.target.value })}>
+                  <option value="spc_cat">Categorical Convective</option>
+                  <option value="spc_torn">Tornado Probability</option>
+                  <option value="spc_wind">Damaging Wind Probability</option>
+                  <option value="spc_hail">Severe Hail Probability</option>
+                </Select>
+              </Field>
+            </PanelSection>
+          )}
+
+          {category === 'Warnings' && (
+            <PanelSection title="Warning display">
+              <Checkbox label="Show warning polygons" checked={prefs.overlays.warnings} onChange={(v) => setOverlay('warnings', v)} />
+              <Checkbox label="Show watches" checked={prefs.overlays.watches} onChange={(v) => setOverlay('watches', v)} />
+              <p className="text-[10px] leading-snug text-slate-500">
+                Warning polygons come from the NOAA/NWS CAP feed. Watches are drawn from the same feed.
+              </p>
+            </PanelSection>
+          )}
+
+          {category === 'Notifications' && (
+            <PanelSection title="Alert notifications">
+              <Toggle
+                label="Sound alerts"
+                checked={prefs.soundAlerts}
+                onChange={(v) => onChange({ soundAlerts: v })}
+                description="Play a tone when a new official warning is issued"
+              />
+              <Toggle
+                label="Spoken announcements"
+                checked={prefs.spokenAlerts}
+                onChange={(v) => onChange({ spokenAlerts: v })}
+                description="Read new warning summaries aloud (text-to-speech)"
+              />
+              <p className="text-[10px] leading-snug text-slate-500">
+                Announcements are generated only from real official warning data and are de-duplicated across refreshes.
+              </p>
+            </PanelSection>
+          )}
+
+          {category === 'Appearance' && (
+            <PanelSection title="Appearance">
+              <Field label="Theme">
+                <Select value="dark" onChange={() => {}}>
+                  <option value="dark">Dark (default)</option>
+                </Select>
+              </Field>
+              <Toggle label="Reduce motion" checked={prefs.reduceMotion} onChange={(v) => onChange({ reduceMotion: v })} />
+            </PanelSection>
+          )}
+
+          {category === 'Data & Performance' && (
+            <PanelSection title="Data & performance">
+              <p className="text-[10px] leading-relaxed text-slate-400">
+                MesoVortex WX streams raster tiles directly from public NOAA/NWS/IEM tile services and proxies
+                vector data (warnings, outlooks, boundaries) through its own API routes. No data is stored on the
+                server beyond short-lived caches.
+              </p>
+              <p className="text-[10px] leading-relaxed text-slate-500">
+                Preference changes are saved to this browser automatically.
+              </p>
+            </PanelSection>
+          )}
+
+          {category === 'Account & Privacy' && (
+            <PanelSection title="Account & privacy">
+              <p className="text-[10px] leading-relaxed text-slate-400">
+                This build has no user accounts and does not transmit personal data. Geolocation is used only when
+                you explicitly choose &ldquo;Locate Me&rdquo;.
+              </p>
+            </PanelSection>
+          )}
+        </div>
+      </div>
+    </div>
+  );
+}
