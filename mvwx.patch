+        {categoryLabel} Controls
+        <span className={`text-[10px] uppercase ${tone}`}>{AVAILABILITY_LABEL[product.availability]}</span>
+      </button>
+    );
+  }
+
+  return (
+    <div className="absolute bottom-4 left-4 z-30 flex max-h-[calc(100vh-6rem)] w-80 flex-col overflow-hidden rounded-2xl border border-slate-800 bg-slate-950/95 font-sans text-slate-100 shadow-2xl backdrop-blur-xl transition-all">
+      {/* Header */}
+      <div className="flex items-center justify-between border-b border-slate-800 bg-slate-900/80 p-3">
+        <div className="min-w-0">
+          <div className="flex items-center gap-1.5">
+            <span className="text-[10px] font-black uppercase tracking-wider text-cyan-400">MesoVortex WX</span>
+            <span className={`text-[9px] font-bold uppercase ${tone}`}>{AVAILABILITY_LABEL[product.availability]}</span>
+          </div>
+          <h2 className="truncate text-xs font-black uppercase text-white">{categoryLabel} Controls</h2>
+        </div>
+        <div className="flex items-center gap-1">
+          <button
+            onClick={() => setMinimized(true)}
+            className="flex h-6 w-6 items-center justify-center rounded-lg bg-slate-800 text-xs text-slate-300 hover:text-white"
+            title="Minimize panel"
+          >
+            —
+          </button>
+          <button
+            onClick={() => setCollapsed((v) => !v)}
+            className="flex h-6 w-6 items-center justify-center rounded-lg bg-slate-800 text-xs text-slate-300 hover:text-white"
+            title={collapsed ? 'Expand panel' : 'Collapse panel'}
+          >
+            {collapsed ? '▲' : '▼'}
+          </button>
+        </div>
+      </div>
+
+      {/* Body */}
+      {!collapsed && (
+        <div className="flex-1 space-y-4 overflow-y-auto p-3.5 text-xs">
+          <PlaybackControls
+            frames={frames}
+            index={index}
+            playing={playing}
+            isLive={isLive}
+            speedMs={speedMs}
+            loopAvailable={loopAvailable}
+            timestampLabel={timestampLabel}
+            onTogglePlay={onTogglePlay}
+            onStep={onStep}
+            onScrub={onScrub}
+            onGoLive={onGoLive}
+            onSpeedChange={onSpeedChange}
+          />
+          {children}
+        </div>
+      )}
+    </div>
+  );
+}
