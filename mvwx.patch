+            <h2 className="text-base font-extrabold text-white">{category} Settings</h2>
+            <div className="flex gap-2">
+              <button onClick={onReset} className="rounded-lg bg-slate-800 px-3 py-1 text-xs text-slate-300 hover:text-white">
+                Reset defaults
+              </button>
+              <button onClick={onClose} className="rounded-lg bg-blue-600 px-3 py-1 text-xs font-bold text-white hover:bg-blue-500">
+                ✕ Close
+              </button>
+            </div>
+          </div>
+
+          {category === 'General' && (
+            <PanelSection title="Application preferences">
+              <Field label="Default startup product">
+                <Select value={prefs.category} onChange={(e) => onChange({ category: e.target.value as any })}>
+                  {['Radar', '3D Radar', 'Composite', 'Satellite', 'Models', 'Outlooks'].map((c) => (
