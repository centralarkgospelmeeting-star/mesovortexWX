+'use client';
+
+import { useState } from 'react';
+import { getProductsByCategory, AVAILABILITY_LABEL } from '../../../lib/product-config';
+import { Field, PanelSection, Select, Slider, Toggle, Badge, EmptyNote } from '../ui';
+import type { ControlProps } from './RadarControls';
+
+export function CompositeControls({
+  product,
+  onSelectProduct,
+  opacity,
+  onChangeOpacity,
+  smoothing,
+  onToggleSmoothing,
+}: ControlProps) {
+  const products = getProductsByCategory('composite');
+  const [advancedOpen, setAdvancedOpen] = useState(false);
+
+  return (
+    <>
+      <PanelSection title="Composite Product">
+        <Field label="Product" hint={AVAILABILITY_LABEL[product.availability]}>
+          <Select value={product.id} onChange={(e) => onSelectProduct(e.target.value)}>
+            {products.map((p) => (
+              <option key={p.id} value={p.id}>
+                {p.label}
+                {p.availability !== 'live' ? ` — ${AVAILABILITY_LABEL[p.availability]}` : ''}
+              </option>
+            ))}
+          </Select>
+        </Field>
+        <p className="text-[10px] leading-snug text-slate-500">{product.description}</p>
+      </PanelSection>
+
+      <PanelSection title="Display">
+        <Field label="Opacity" hint={`${Math.round(opacity * 100)}%`}>
+          <Slider value={opacity} min={0.2} max={1} step={0.05} onChange={onChangeOpacity} ariaLabel="Composite opacity" />
+        </Field>
+        <Toggle label="Smoothing" checked={smoothing} onChange={onToggleSmoothing} />
+      </PanelSection>
+
+      <PanelSection
+        title="Severe Weather Composites"
+        action={
+          <button onClick={() => setAdvancedOpen((v) => !v)} className="text-[10px] font-bold text-cyan-400">
+            {advancedOpen ? 'Hide' : 'Info'}
+          </button>
+        }
+      >
+        {advancedOpen ? (
+          <EmptyNote>
+            Severe-weather composite products (rotation tracks, hail swaths and combined severe indices) are
+            derived from MRMS mosaics. Those that are available appear in the product list above and are marked
+            Experimental.
+          </EmptyNote>
+        ) : (
+          <div className="flex flex-wrap gap-1">
+            <Badge tone="emerald">Live mosaics</Badge>
+            <Badge tone="fuchsia">Experimental derived</Badge>
+          </div>
+        )}
+      </PanelSection>
+    </>
+  );
+}
