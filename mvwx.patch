new file mode 100644
index 0000000..50c7b55
--- /dev/null
+++ b/components/shell/TopNavigation.tsx
@@ -0,0 +1,190 @@
+'use client';
+
+import Image from 'next/image';
+import { useEffect, useRef, useState } from 'react';
+import { NAV_CATEGORIES, type NavCategory } from '../../lib/shell/types';
+
+export type GeoResult = {
+  label: string;
+  detail: string;
+  lat: number;
+  lon: number;
+  nearestRadar?: string;
+  kind: 'radar' | 'city' | 'coordinate';
+};
+
+type Props = {
+  activeCategory: NavCategory;
+  onSelectCategory: (c: NavCategory) => void;
+  warningCount: number;
+  warningDrawerOpen: boolean;
+  onToggleWarningDrawer: () => void;
+  onToggleMainMenu: () => void;
+  onSelectLocation: (r: GeoResult) => void;
+};
+
+const KIND_ICON: Record<GeoResult['kind'], string> = {
+  radar: '📡',
+  city: '📍',
+  coordinate: '🧭',
+};
+
+export function TopNavigation({
+  activeCategory,
+  onSelectCategory,
+  warningCount,
+  warningDrawerOpen,
+  onToggleWarningDrawer,
+  onToggleMainMenu,
+  onSelectLocation,
+}: Props) {
+  const [query, setQuery] = useState('');
+  const [results, setResults] = useState<GeoResult[]>([]);
+  const [open, setOpen] = useState(false);
+  const [searching, setSearching] = useState(false);
+  const boxRef = useRef<HTMLDivElement | null>(null);
+
+  // Debounced geocode lookup.
+  useEffect(() => {
+    const q = query.trim();
+    if (q.length < 2) {
+      setResults([]);
+      return;
+    }
+    const controller = new AbortController();
+    const timer = setTimeout(async () => {
+      setSearching(true);
+      try {
+        const res = await fetch(`/api/geocode?q=${encodeURIComponent(q)}`, { signal: controller.signal });
+        const data = await res.json();
+        setResults(data.results || []);
+        setOpen(true);
+      } catch {
+        // aborted or offline — leave existing results
+      } finally {
+        setSearching(false);
+      }
+    }, 350);
+    return () => {
+      clearTimeout(timer);
+      controller.abort();
+    };
+  }, [query]);
+
+  // Close the dropdown on outside click.
+  useEffect(() => {
+    function onDoc(e: MouseEvent) {
+      if (boxRef.current && !boxRef.current.contains(e.target as Node)) setOpen(false);
+    }
+    document.addEventListener('mousedown', onDoc);
+    return () => document.removeEventListener('mousedown', onDoc);
+  }, []);
+
+  function choose(r: GeoResult) {
+    onSelectLocation(r);
+    setQuery('');
+    setResults([]);
+    setOpen(false);
+  }
+
+  return (
+    <header className="pointer-events-none absolute left-0 right-0 top-6 z-40 flex items-center justify-between gap-2 px-3 py-1 font-sans select-none">
+      {/* Left: main menu */}
+      <div className="pointer-events-auto flex items-center gap-2">
+        <button
+          onClick={onToggleMainMenu}
+          aria-label="Open main menu"
+          className="flex h-9 w-9 items-center justify-center rounded-xl border border-slate-700 bg-slate-900/90 text-slate-100 shadow-xl backdrop-blur-md transition hover:bg-slate-800"
+        >
+          ☰
+        </button>
+      </div>
+
+      {/* Center: brand + search + tabs */}
+      <div className="pointer-events-auto flex min-w-0 items-center gap-2 rounded-full border border-slate-800 bg-slate-950/90 p-1 shadow-2xl backdrop-blur-xl">
+        <div className="flex shrink-0 items-center gap-2 border-r border-slate-800 pl-2 pr-3">
+          <Image src="/icons/app-icon.svg" alt="MesoVortex WX" width={24} height={24} className="rounded-full shadow-sm" priority />
+          <span className="hidden font-black text-xs uppercase tracking-wider text-white lg:inline">
+            MESO<span className="text-cyan-400">VORTEX</span>{' '}
+            <span className="text-[9px] font-bold text-amber-400">WX</span>
+          </span>
+        </div>
+
+        {/* Location search */}
+        <div ref={boxRef} className="relative hidden md:block">
+          <span className="pointer-events-none absolute left-2.5 top-1/2 -translate-y-1/2 text-xs text-slate-500">
+            🔍
+          </span>
+          <input
+            type="text"
+            value={query}
+            onChange={(e) => setQuery(e.target.value)}
+            onFocus={() => results.length && setOpen(true)}
+            placeholder="City, ZIP, address, coords, or radar…"
+            aria-label="Search for a location"
+            className="w-52 rounded-full border border-slate-800 bg-slate-900 py-1 pl-7 pr-3 text-[11px] text-white placeholder-slate-500 focus:border-cyan-500 focus:outline-none lg:w-64"
+          />
+          {open && (results.length > 0 || searching) && (
+            <div className="absolute left-0 top-[110%] z-50 w-80 overflow-hidden rounded-xl border border-slate-700 bg-slate-950/98 shadow-2xl backdrop-blur">
+              {searching && results.length === 0 && (
+                <div className="px-3 py-2 text-[11px] text-slate-400">Searching…</div>
+              )}
+              {results.map((r, i) => (
+                <button
+                  key={`${r.lat}-${r.lon}-${i}`}
+                  onClick={() => choose(r)}
+                  className="flex w-full items-start gap-2 border-b border-slate-800/70 px-3 py-2 text-left transition last:border-b-0 hover:bg-slate-900"
+                >
+                  <span aria-hidden className="mt-0.5 text-xs">
+                    {KIND_ICON[r.kind]}
+                  </span>
+                  <span className="min-w-0">
+                    <span className="block truncate text-[11px] font-bold text-white">{r.label}</span>
+                    <span className="block truncate text-[10px] text-slate-400">
+                      {r.detail}
+                      {r.nearestRadar ? ` · nearest radar ${r.nearestRadar}` : ''}
+                    </span>
+                  </span>
+                </button>
+              ))}
+            </div>
+          )}
+        </div>
+
+        {/* Product navigation */}
+        <nav className="flex items-center gap-0.5 text-xs font-bold">
+          {NAV_CATEGORIES.map((c) => (
+            <button
+              key={c}
+              onClick={() => onSelectCategory(c)}
+              className={`whitespace-nowrap rounded-full px-2.5 py-1 transition lg:px-3 ${
+                activeCategory === c
+                  ? 'bg-blue-600 text-white shadow-md'
+                  : 'text-slate-400 hover:bg-slate-900 hover:text-slate-200'
+              }`}
+            >
+              {c}
+            </button>
+          ))}
+        </nav>
+      </div>
+
+      {/* Right: warning button */}
+      <div className="pointer-events-auto flex items-center gap-2">
+        <button
+          onClick={onToggleWarningDrawer}
+          aria-label="Toggle active warnings drawer"
+          aria-expanded={warningDrawerOpen}
+          className={`flex items-center gap-1.5 rounded-full border px-3 py-1.5 text-xs font-black shadow-xl backdrop-blur-md transition ${
+            warningDrawerOpen
+              ? 'border-red-400 bg-red-500 text-white'
+              : 'border-red-500/50 bg-red-600/90 text-white hover:bg-red-500'
+          }`}
+        >
+          <span aria-hidden>⚠️</span>
+          <span>{warningCount}</span>
+        </button>
+      </div>
+    </header>
+  );
+}
diff --git a/components/shell/UniversalDataLegend.tsx b/components/shell/UniversalDataLegend.tsx
new file mode 100644
index 0000000..ed775d2
--- /dev/null
+++ b/components/shell/UniversalDataLegend.tsx
@@ -0,0 +1,175 @@
+'use client';
+
+import { useEffect, useMemo, useState } from 'react';
+import type { LegendSpec, LegendStop, ProductAvailability } from '../../lib/product-config';
+
+type Props = {
+  legend: LegendSpec;
+  /** Availability badge for the active product (live / proxy / experimental). */
+  availability?: ProductAvailability;
+  availabilityLabel?: string;
+  /** Short note about data provenance / limitations. */
+  sourceNote?: string;
+  /** Optional active product label rendered at the left of the strip. */
+  productLabel?: string;
+  /** A new-warning announcement that briefly expands the legend area. */
+  announcement?: { id: string; text: string; tone?: 'red' | 'amber' | 'blue' } | null;
+  onDismissAnnouncement?: () => void;
+};
+
+const TONE_BG: Record<string, string> = {
+  red: 'bg-red-600',
+  amber: 'bg-amber-500',
+  blue: 'bg-blue-600',
+};
+
+function Tooltip({ stop, unit }: { stop: LegendStop; unit?: string }) {
+  return (
+    <span className="whitespace-nowrap">
+      <span className="mr-1.5 inline-block h-2 w-2 rounded-full" style={{ backgroundColor: stop.color }} />
+      {stop.value}
+      {unit && !stop.value.includes(unit) ? ` ${unit}` : ''}
+    </span>
+  );
+}
+
+export function UniversalDataLegend({
+  legend,
+  availability,
+  availabilityLabel,
+  sourceNote,
+  productLabel,
+  announcement,
+  onDismissAnnouncement,
+}: Props) {
+  const [hovered, setHovered] = useState<{ stop: LegendStop; index: number } | null>(null);
+  const [showNote, setShowNote] = useState(false);
+
+  // Auto-dismiss the announcement after a short window so it never lingers.
+  useEffect(() => {
+    if (!announcement) return;
+    const timer = setTimeout(() => onDismissAnnouncement?.(), 12000);
+    return () => clearTimeout(timer);
+  }, [announcement, onDismissAnnouncement]);
+
+  const availabilityTone = useMemo(() => {
+    switch (availability) {
+      case 'live':
+        return 'text-emerald-300 border-emerald-500/40 bg-emerald-500/10';
+      case 'proxy':
+        return 'text-amber-300 border-amber-500/40 bg-amber-500/10';
+      case 'experimental':
+        return 'text-fuchsia-300 border-fuchsia-500/40 bg-fuchsia-500/10';
+      default:
+        return 'text-slate-300 border-slate-600 bg-slate-800/60';
+    }
+  }, [availability]);
+
+  return (
+    <div className="pointer-events-none relative z-50 w-full">
+      <div className="pointer-events-auto flex h-6 w-full items-stretch bg-slate-950/95 font-sans text-[9px] shadow-md backdrop-blur">
+        {/* Product label block */}
+        <div className="flex w-max shrink-0 items-center gap-2 border-r border-slate-800 px-3">
+          <span className="font-black uppercase tracking-wider text-white">
+            {productLabel || legend.title}
+          </span>
+          {legend.unit && (
+            <span className="font-mono text-[9px] text-slate-400">({legend.unit})</span>
+          )}
+          {availability && availabilityLabel && (
+            <span className={`rounded border px-1 py-[1px] text-[8px] font-bold uppercase ${availabilityTone}`}>
+              {availabilityLabel}
+            </span>
+          )}
+          {sourceNote && (
+            <button
+              type="button"
+              onClick={() => setShowNote((v) => !v)}
+              title="Data provenance"
+              className="rounded border border-slate-700 bg-slate-900 px-1 text-[8px] font-bold text-slate-400 hover:text-white"
+            >
+              ⓘ
+            </button>
+          )}
+        </div>
+
+        {/* Scale */}
+        <div className="flex flex-1 items-stretch">
+          {legend.kind === 'gradient'
+            ? legend.stops.map((stop, i) => (
+                <div
+                  key={i}
+                  style={{ backgroundColor: stop.color }}
+                  onMouseEnter={() => setHovered({ stop, index: i })}
+                  onMouseLeave={() => setHovered(null)}
+                  className="flex flex-1 items-center justify-center transition-opacity hover:opacity-80"
+                />
+              ))
+            : legend.stops.map((stop, i) => (
+                <div
+                  key={i}
+                  style={{ backgroundColor: stop.color }}
+                  onMouseEnter={() => setHovered({ stop, index: i })}
+                  onMouseLeave={() => setHovered(null)}
+                  className="flex flex-1 items-center justify-center font-bold text-slate-950/80 transition-opacity hover:opacity-80"
+                >
+                  <span className="hidden sm:inline">{stop.short || stop.value}</span>
+                </div>
+              ))}
+        </div>
+
+        {/* Min/max endpoint hints for gradient scales */}
+        {legend.kind === 'gradient' && (
+          <div className="flex w-max shrink-0 items-center gap-2 border-l border-slate-800 px-3 font-mono text-[9px] text-slate-400">
+            <span>{legend.stops[0]?.value.split(' ')[0]}</span>
+            <span className="text-slate-600">→</span>
+            <span>{legend.stops[legend.stops.length - 1]?.value.split(' ')[0]}</span>
+          </div>
+        )}
+      </div>
+
+      {/* Hover readout */}
+      {hovered && (
+        <div
+          className="pointer-events-none absolute top-[26px] z-50 -translate-x-1/2 rounded-full border border-white/20 bg-slate-950/95 px-3 py-0.5 text-[10px] font-mono font-bold text-white shadow-2xl backdrop-blur-md"
+          style={{
+            left: `${((hovered.index + 0.5) / legend.stops.length) * 100}%`,
+          }}
+        >
+          <Tooltip stop={hovered.stop} unit={legend.unit} />
+        </div>
+      )}
+
+      {/* Provenance note */}
+      {showNote && sourceNote && (
+        <div className="pointer-events-auto absolute left-2 top-[30px] z-50 max-w-sm rounded-lg border border-amber-500/40 bg-slate-950/97 p-3 text-[10px] leading-relaxed text-amber-100 shadow-2xl backdrop-blur">
+          <div className="mb-1 flex items-center justify-between">
+            <span className="font-black uppercase tracking-wider text-amber-300">Data provenance</span>
+            <button onClick={() => setShowNote(false)} className="text-slate-400 hover:text-white">
+              ✕
+            </button>
+          </div>
+          {sourceNote}
+        </div>
+      )}
+
+      {/* Warning announcement banner — expands the legend area temporarily */}
+      {announcement && (
+        <div
+          className={`pointer-events-auto flex items-center gap-3 border-b border-black/30 px-3 py-1.5 text-[11px] font-bold text-white shadow-lg ${
+            TONE_BG[announcement.tone || 'red']
+          }`}
+        >
+          <span aria-hidden>⚠️</span>
+          <span className="min-w-0 flex-1 truncate">{announcement.text}</span>
+          <button
+            onClick={onDismissAnnouncement}
+            className="rounded bg-black/25 px-2 py-0.5 text-[10px] hover:bg-black/40"
+          >
+            Dismiss
+          </button>
+        </div>
+      )}
+    </div>
+  );
+}
diff --git a/components/shell/WarningDrawer.tsx b/components/shell/WarningDrawer.tsx
new file mode 100644
index 0000000..b0f4290
--- /dev/null
+++ b/components/shell/WarningDrawer.tsx
@@ -0,0 +1,201 @@
+'use client';
+
+import { useMemo, useState } from 'react';
+import type { WarningAlert } from '../../lib/shell/useWarnings';
+
+type Props = {
+  open: boolean;
+  onClose: () => void;
+  alerts: WarningAlert[];
+  newIds: Set<string>;
+  loading: boolean;
+  error: string | null;
+  lastUpdated: string | null;
+  selectedId: string | null;
+  onSelect: (w: WarningAlert) => void;
+};
+
+type FilterKey = 'ALL' | 'TORNADO' | 'SEVERE' | 'FLOOD' | 'WINTER' | 'TROPICAL';
+
+const FILTERS: { key: FilterKey; label: string }[] = [
+  { key: 'ALL', label: 'All' },
+  { key: 'TORNADO', label: 'Tornado' },
+  { key: 'SEVERE', label: 'Severe' },
+  { key: 'FLOOD', label: 'Flood' },
+  { key: 'WINTER', label: 'Winter' },
+  { key: 'TROPICAL', label: 'Tropical' },
+];
+
+function matches(a: WarningAlert, key: FilterKey): boolean {
+  const e = a.event;
+  switch (key) {
+    case 'TORNADO':
+      return e.includes('Tornado');
+    case 'SEVERE':
+      return e.includes('Severe Thunderstorm') || e.includes('Severe');
+    case 'FLOOD':
+      return e.includes('Flood');
+    case 'WINTER':
+      return /Winter|Blizzard|Ice Storm|Snow|Freeze|Frost/i.test(e);
+    case 'TROPICAL':
+      return /Hurricane|Tropical Storm|Storm Surge|Tropical/i.test(e);
+    default:
+      return true;
+  }
+}
+
+function severityTone(sev: string): string {
+  switch (sev) {
+    case 'Extreme':
+      return 'bg-red-600 text-white';
+    case 'Severe':
+      return 'bg-orange-600 text-white';
+    case 'Moderate':
+      return 'bg-amber-500 text-slate-950';
+    default:
+      return 'bg-blue-600 text-white';
+  }
+}
+
+export function WarningDrawer({
+  open,
+  onClose,
+  alerts,
+  newIds,
+  loading,
+  error,
+  lastUpdated,
+  selectedId,
+  onSelect,
+}: Props) {
+  const [filter, setFilter] = useState<FilterKey>('ALL');
+  const [query, setQuery] = useState('');
+
+  const filtered = useMemo(() => {
+    const q = query.trim().toLowerCase();
+    return alerts.filter((a) => {
+      if (!matches(a, filter)) return false;
+      if (q && !`${a.event} ${a.areaDesc} ${a.headline}`.toLowerCase().includes(q)) return false;
+      return true;
+    });
+  }, [alerts, filter, query]);
+
+  const counts = useMemo(() => {
+    const map: Record<string, number> = { ALL: alerts.length };
+    for (const f of FILTERS) {
+      if (f.key === 'ALL') continue;
+      map[f.key] = alerts.filter((a) => matches(a, f.key)).length;
+    }
+    return map;
+  }, [alerts]);
+
+  if (!open) return null;
+
+  return (
+    <aside
+      aria-label="Active weather warnings"
+      className="absolute right-0 top-6 bottom-0 z-40 flex w-80 flex-col border-l border-slate-800 bg-slate-950/96 font-sans text-slate-100 shadow-2xl backdrop-blur-2xl sm:w-96"
+    >
+      {/* Header */}
+      <div className="flex items-center justify-between border-b border-slate-800 bg-slate-900/60 p-3.5">
+        <div className="flex items-center gap-2">
+          <span className="text-base font-black text-white">Active Alerts</span>
+          <span className="rounded-full bg-red-600 px-2 py-0.5 text-[10px] font-black text-white">{alerts.length}</span>
+        </div>
+        <button
+          onClick={onClose}
+          aria-label="Close warning drawer"
+          className="rounded-lg bg-slate-800 p-1.5 text-xs text-slate-400 transition hover:text-white"
+        >
+          ✕
+        </button>
+      </div>
+
+      {/* Search */}
+      <div className="border-b border-slate-800 p-2.5">
+        <input
+          value={query}
+          onChange={(e) => setQuery(e.target.value)}
+          placeholder="Filter by county, state or event…"
+          aria-label="Filter warnings"
+          className="w-full rounded-lg border border-slate-700 bg-slate-900 px-2.5 py-1.5 text-[11px] text-white placeholder-slate-500 focus:border-cyan-500 focus:outline-none"
+        />
+      </div>
+
+      {/* Category filters with counts */}
+      <div className="flex flex-wrap gap-1.5 border-b border-slate-800 p-2.5 text-[11px] font-bold">
+        {FILTERS.map((f) => (
+          <button
+            key={f.key}
+            onClick={() => setFilter(f.key)}
+            className={`rounded-lg px-2 py-1 transition ${
+              filter === f.key ? 'bg-blue-600 text-white shadow' : 'bg-slate-900 text-slate-400 hover:bg-slate-800 hover:text-white'
+            }`}
+          >
+            {f.label}
+            <span className="ml-1 text-[9px] opacity-70">{counts[f.key] ?? 0}</span>
+          </button>
+        ))}
+      </div>
+
+      {/* List */}
+      <div className="flex-1 space-y-2.5 overflow-y-auto p-3 text-xs">
+        {loading && filtered.length === 0 && <div className="p-6 text-center text-slate-500">Loading live warnings…</div>}
+        {error && (
+          <div className="rounded-lg border border-amber-500/40 bg-amber-500/10 p-3 text-[11px] text-amber-200">
+            Could not reach the warning feed ({error}). Showing the last known data.
+          </div>
+        )}
+
+        {filtered.map((item) => {
+          const isNew = newIds.has(item.id);
+          const isSelected = selectedId === item.id;
+          return (
+            <button
+              key={item.id}
+              onClick={() => onSelect(item)}
+              className={`w-full rounded-xl border p-3 text-left transition hover:scale-[1.01] hover:shadow-lg ${
+                isSelected
+                  ? 'border-cyan-400 bg-cyan-950/30'
+                  : isNew
+                  ? 'border-red-400 bg-red-950/30'
+                  : 'border-slate-700 bg-slate-900/60'
+              }`}
+            >
+              <div className="mb-1.5 flex items-center justify-between gap-2">
+                <span className={`rounded px-1.5 py-0.5 text-[9px] font-black uppercase ${severityTone(item.severity)}`}>
+                  {item.event}
+                </span>
+                {isNew && (
+                  <span className="rounded bg-red-600 px-1.5 py-0.5 text-[8px] font-black uppercase text-white">New</span>
+                )}
+              </div>
+              <div className="line-clamp-2 text-xs font-bold leading-snug text-white">{item.headline}</div>
+              <div className="mt-1 line-clamp-1 text-[11px] text-slate-400">{item.areaDesc || 'Multiple counties'}</div>
+              <div className="mt-1 flex items-center justify-between text-[10px] font-mono text-slate-500">
+                <span>{item.wfo || 'NWS'}</span>
+                <span>{item.expires ? `Exp ${item.expires.slice(11, 16)}z` : 'Active'}</span>
+              </div>
+            </button>
+          );
+        })}
+
+        {!loading && filtered.length === 0 && (
+          <div className="p-8 text-center text-xs text-slate-500">No active alerts match this filter.</div>
+        )}
+      </div>
+
+      {/* Footer */}
+      <div className="border-t border-slate-800 p-2.5 text-[10px] text-slate-500">
+        <div className="flex items-center justify-between">
+          <span>Source: NOAA / NWS CAP feed</span>
+          <span className="text-emerald-400">{lastUpdated ? `Updated ${lastUpdated.slice(11, 16)}z` : '—'}</span>
+        </div>
+        <p className="mt-1 leading-snug">
+          Official warnings only. Experimental AI detections and community reports are labelled separately and are
+          never presented as official warnings.
+        </p>
+      </div>
+    </aside>
+  );
+}
