+'use client';
+
+import { useState, type ReactNode } from 'react';
+import { AVAILABILITY_LABEL, type ProductDef } from '../../lib/product-config';
+import { PlaybackControls } from './PlaybackControls';
+import type { PlaybackFrame } from '../../lib/shell/usePlayback';
+import type { ControlProps } from './controls/RadarControls';
+
+type Props = {
+  categoryLabel: string;
+  product: ProductDef;
+  children: ReactNode;
+  // Playback
+  frames: PlaybackFrame[];
+  index: number;
+  playing: boolean;
+  isLive: boolean;
+  speedMs: number;
+  loopAvailable: boolean;
+  timestampLabel: string;
+  onTogglePlay: () => void;
+  onStep: (dir: -1 | 1) => void;
+  onScrub: (i: number) => void;
+  onGoLive: () => void;
+  onSpeedChange: (ms: number) => void;
+};
+
+export function FloatingProductPanel({
+  categoryLabel,
+  product,
+  children,
+  frames,
+  index,
+  playing,
+  isLive,
+  speedMs,
+  loopAvailable,
+  timestampLabel,
+  onTogglePlay,
+  onStep,
+  onScrub,
+  onGoLive,
+  onSpeedChange,
+}: Props) {
+  const [collapsed, setCollapsed] = useState(false);
+  const [minimized, setMinimized] = useState(false);
+
+  const tone =
+    product.availability === 'live'
+      ? 'text-emerald-400'
+      : product.availability === 'proxy'
+      ? 'text-amber-400'
+      : product.availability === 'experimental'
+      ? 'text-fuchsia-400'
+      : 'text-slate-400';
+
+  if (minimized) {
+    return (
+      <button
+        onClick={() => setMinimized(false)}
