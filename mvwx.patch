+
+export type BasemapType = 'satellite-streets' | 'custom-weather' | 'dark' | 'streets';
+
+export type MapFocus = {
+  lon: number;
+  lat: number;
+  zoom: number;
+  /** Monotonic key so repeated focus requests to the same point still fire. */
